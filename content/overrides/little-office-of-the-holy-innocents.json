        {
          "type": "prayer",
          "source": "Mirum plane rerum thema! Christo negans diadema Rex Herodes impius, Rosas legit, serta nectit, Ipseque coronas nectit Pueris infantibus;",
          "english": null,
          "sourcePages": [
            523
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Dum praeclaros Milites Christi Jesu exultantis, Viam Crucis incohantis, Promovet in Martyres.",
          "english": null,
          "sourcePages": [
            523
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Ecce profanus hostis nunquam beatis Parvulis tantum prodesse potuisset obsequio, quantum profuit odio.",
          "english": null,
          "sourcePages": [
            523
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Agnelli debent immolari,",
          "english": null,
          "sourcePages": [
            523
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Quia Agnus debebit crucifigi.",
