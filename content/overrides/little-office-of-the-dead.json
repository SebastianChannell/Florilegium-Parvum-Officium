          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Quam velim vobis dexteram, Opemque praesentare! Uthine ad caeli gloriam Possitis evolare!",
          "english": null,
          "sourcePages": [
            611
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Illuminare his, qui in tenebris et in umbra mortis sedent, ad dirigendos pedes eorum in viam pacis.",
