        {
          "type": "prayer",
          "source": "Dum Christo pedes lavera O pia Magdalena! Jam abs reatu fueras Favore Jesu plena, Tot ergo adhuc gemitus Cur edis? Eequid vultus Cum lachrymarum fluctibus Tot exprimit singultus?",
          "english": null,
          "sourcePages": [
            566
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Antiph. Quoniam iniquitatem meam ego cognosco: et peccatum meum contra me est semper.",
          "english": null,
          "sourcePages": [
            566
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ora pro nobis S. M. Magdalena.",
          "english": null,
          "sourcePages": [
            566
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut digni efficiamur promissionibus Christi.",
          "english": "℟. That we may be made worthy of the promises of Christ.",
