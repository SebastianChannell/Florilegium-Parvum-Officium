          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": "Let us pray,",
          "sourcePages": [
            566
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              566
            ],
            "review": "editorial-review-complete",
            "method": "exact-source-memory",
            "memoryId": "e4264868331a5239"
          },
          "alignment": "reviewed",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Beatae Mariae Magdalenae quaesumus Domine, suffragiis adjuvemur, ut quam fides et dilectio sua salvam fecit, ejus quoque meritis ab omnibus malis salvemur in corpore, et a peccatis nostris per veram poenitentiam mundati in mente, aeternum tibi collaetemur in coelis; Qui vivis etc. Amen.",
          "english": null,
          "sourcePages": [
            566
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        }
