      "blocks": [
        {
          "type": "prayer",
          "source": "Exemplar Poenitentium O Magdalena diva! Piarum norma meritum, Martyr Amoris viva! Has Preces, quaeso, suscipe, Veraque nos gubern a Per viam Poenitentiae Ad gaudia aeterna.",
          "english": null,
          "sourcePages": [
            568
