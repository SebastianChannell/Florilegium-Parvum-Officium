      "title": "Ordinary",
      "sourceHeading": "Ordinaria",
      "pages": [
        54
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "℣. Panem Angelorum manducavit homo, et paratur ei mensa Domini.",
          "english": "℣. Man hath eaten the bread of Angels, and the table of our Lord is prepared for him.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0001",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "rubric",
          "source": "Ad Matutinum",
          "english": "At Matins only",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0002",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "prayer",
          "source": "℣. Domine labia mea aperies.",
          "english": "℣. O Lord, open my lips.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0003",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": "℟. And my mouth will announce Thy praise.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0004",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "rubric",
          "source": "Ad Completorium",
          "english": "At Compline only",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0005",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "prayer",
          "source": "℣. Converte nos, Deus salutaris noster.",
          "english": "℣. Convert us, O God our Saviour.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0006",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "prayer",
          "source": "℟. Et averte iram tuam a nobis.",
          "english": "℟. And turn away Thy wrath from us.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0007",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "rubric",
          "source": "Ad Horas Omnes",
          "english": "At all the Hours",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0008",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "prayer",
          "source": "℣. Deus in adiutorium meum intende.",
          "english": "℣. O God, come to my aid.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0009",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adiuvandum me festina.",
          "english": "℟. O Lord, make haste to help me.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0010",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "prayer",
          "source": "℣. Gloria Patri, et Filio, et Spiritui Sancto.",
          "english": "℣. Glory be to the Father, and to the Son, and to the Holy Spirit.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0011",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "prayer",
          "source": "℟. Sicut erat in principio, et nunc, et semper, et in saecula saeculorum. Alleluia.",
          "english": "℟. As it was in the beginning, is now, and ever shall be, world without end. Alleluia.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0012",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        },
        {
          "type": "rubric",
          "source": "A Septuagesima usque ad Pascha, loco Alleluia, dicitur: Laus tibi, Domine, Rex aeternae gloriae.",
          "english": "During Lent until Easter, instead of the alleluia the following is said: Praise to Thee, O Lord, King of everlasting glory.",
          "sourcePages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0013",
          "verification": "visual-review",
          "englishPages": [
            54
          ]
        }
      ]
    },
    {
      "id": "matins",
      "title": "Matins",
      "sourceHeading": "Ad Matutinum",
      "pages": [
        54
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Pange, lingua, gloriosi Corporis mysterium, Sanguinisque pretiosi, quem in mundi pretium fructus ventris generosi Rex effudit Gentium.",
          "english": "Sing, my tongue, the Saviour’s glory, of His flesh the mystery sing; of the Blood, all price exceeding, shed by our immortal King, destined, for the world’s redemption, from a noble womb to spring.",
          "sourcePages": [
            54
          ],
          "englishPages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "reviewed",
          "id": "matins-b0001",
          "verification": "visual-review",
          "poetry": true
        }
      ],
