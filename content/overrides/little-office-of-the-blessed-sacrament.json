    {
      "id": "conclusion",
      "title": "Conclusion",
      "sourceHeading": "Conclusio",
      "pages": [
        55,
        56
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "O quam suavis est Domine spiritus tuus, qui ut dulcedinem tuam in filios demonstrares, pane suavissimo de caelo praestito esurientes reples bonis, fastidiosos divites dimittens inanes.",
          "english": "O how sweet, O Lord, is Thy Spirit, who, that Thou mightest show Thy sweetness towards Thy children, by most sweet bread sent from Heaven fillest the hungry with good things, send the rich away empty.",
          "sourcePages": [
            55,
            56
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              56
            ]
          },
          "alignment": "reviewed",
          "id": "conclusion-b0001",
          "verification": "visual-review",
          "englishPages": [
            56
          ]
        },
        {
          "type": "prayer",
          "source": "℣. Panem de caelo praestitisti eis.",
          "english": "℣. Thou hast given us bread from Heaven.",
          "sourcePages": [
            56
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              56
            ]
          },
          "alignment": "reviewed",
          "id": "conclusion-b0002",
          "verification": "visual-review",
          "englishPages": [
            56
          ]
        },
        {
          "type": "prayer",
          "source": "℟. Omne delectamentum in se habentem.",
          "english": "℟. Filled with all sweetness and delight.",
          "sourcePages": [
            56
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              56
            ]
          },
          "alignment": "reviewed",
          "id": "conclusion-b0003",
          "verification": "visual-review",
          "englishPages": [
            56
          ]
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": "Let us pray,",
          "sourcePages": [
            56
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              56
            ]
          },
          "alignment": "reviewed",
          "id": "conclusion-b0004",
          "verification": "visual-review",
          "englishPages": [
            56
          ]
        },
        {
          "type": "prayer",
          "source": "Deus, qui nobis sub Sacramento mirabili Passionis tuae memoriam reliquisti; tribue, quaesumus, ita nos Corporis et Sanguinis tui sacra mysteria venerari, ut redemptionis tuae fructum in nobis iugiter sentiamus: Qui vivis et regnas in saecula saeculorum. Amen.",
          "english": "O God, who under a wonderful Sacrament hast left us a memorial of Thy Passion; grant us, we beseech Thee, so to reverence the sacred mysteries of Thy Body and Blood, that we may ever feel within ourselves the fruit of Thy Redemption: Thou who livest and reignest forever and ever. Amen.",
          "sourcePages": [
            56
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              56
            ]
          },
          "alignment": "reviewed",
          "id": "conclusion-b0005",
          "verification": "visual-review",
          "englishPages": [
            56
          ]
        }
      ]
    }
