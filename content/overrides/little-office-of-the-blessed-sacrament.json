  "editorialNotes": [
    {
      "pages": [
        54
      ],
      "text": "The Latin prescribes the replacement of Alleluia from Septuagesima until Easter; the supplied English says “During Lent until Easter.” Both source wordings are retained. The seasonal instruction is shown with the Ordinary so the reader can follow the applicable form."
    }
  ]
}
