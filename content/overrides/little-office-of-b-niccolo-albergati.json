          "sourcePages": [
            569
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Benedicam Dominum in omni tempore.",
