          "sourcePages": [
            569
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Exaudi quaesumus Domine preces nostras, quas in Beati Nicolai Confessoris tui atque Pontificis solemnitate deferimus: et qui Tibi digne meruit famulari, ejus intercedentibus meritis, ab omnibus nos absolve peccatis. Per Dominum nostrum Jesum Christum Filium tuum, qui tecum vivit et regnat in unitate Spiritus Sancti Deus, per omnia saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            569
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
