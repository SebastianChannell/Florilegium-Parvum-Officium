        {
          "type": "prayer",
          "source": "Magni Patris magnae Proli, E Brunonis caelo Soli Lingua laudes resonat, Dulce melos intonat.",
          "english": null,
          "sourcePages": [
            569
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Nicolai Albergati, Caeli Civis ter Beati, Celebra memoriam, Meditare gloriam.",
          "english": null,
          "sourcePages": [
            569
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Candicantem puritatem, Purpuratam sanctitatem, Sacras decet Violas Magni Myrae recolat.",
          "english": null,
          "sourcePages": [
            569
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Pia tibi mens probetur Dive, esto superetur Labii inopia Laudandorum copia.",
