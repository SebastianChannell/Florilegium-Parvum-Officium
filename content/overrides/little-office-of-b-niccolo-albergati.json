            569
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Semper laus ejus in ore meo. (Ps. 33) Oremus,",
