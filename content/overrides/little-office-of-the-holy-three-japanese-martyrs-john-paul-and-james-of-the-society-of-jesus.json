          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam. Gloria Patri, et Filio, et Spiritui Sancto, Sicut erat in principio, et nunc, et semper, et in saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            545
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
