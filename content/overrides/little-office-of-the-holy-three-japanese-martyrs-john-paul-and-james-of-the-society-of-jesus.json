            "memoryId": "199b581454fdecd3"
          },
          "alignment": "reviewed",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Per quem nobis mundus crucifixus est, et nos mundo.",
          "english": "℟. Through Whom the world is crucified to us, and we to the world.",
