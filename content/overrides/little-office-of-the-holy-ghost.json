      "title": "Ordinary",
      "sourceHeading": "Ordinaria",
      "pages": [
        90
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Spiritus sancti gratia illuminet sensus et corda nostra. Amen.",
          "english": "May the grace of the Holy Ghost illumine our senses and our hearts. Amen.",
          "sourcePages": [
            90
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              90
            ],
            "review": "editorial-review-complete"
          },
          "alignment": "reviewed",
          "id": "ordinary-b0001",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℣. Domine, labia mea aperies.",
          "english": "℣. O Lord, Thou shalt open my lips.",
          "sourcePages": [
            90
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              90
            ],
            "review": "editorial-review-complete"
          },
          "alignment": "reviewed",
          "id": "ordinary-b0002",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": "℟. And my mouth shall declare Thy praise.",
          "sourcePages": [
            90
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              90
            ],
            "review": "editorial-review-complete"
          },
          "alignment": "reviewed",
          "id": "ordinary-b0003",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℣. Converte nos, Deus salutaris noster.",
          "english": "℣. Convert us, O God our Saviour.",
          "sourcePages": [
            90
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              90
            ],
            "review": "editorial-review-complete"
          },
          "alignment": "reviewed",
          "id": "ordinary-b0004",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℟. Et averte iram tuam a nobis.",
          "english": "℟. And turn away Thine anger from us.",
          "sourcePages": [
            90
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              90
            ],
            "review": "editorial-review-complete"
          },
          "alignment": "reviewed",
          "id": "ordinary-b0005",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℣. Deus, in adjutorium meum intende.",
          "english": "℣. O God, come to my assistance.",
          "sourcePages": [
            90
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              90
            ],
            "review": "editorial-review-complete"
          },
          "alignment": "reviewed",
          "id": "ordinary-b0006",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℟. Domine, ad adjuvandum me festina.",
          "english": "℟. O Lord, make haste to help me.",
          "sourcePages": [
            90
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              90
            ],
            "review": "editorial-review-complete"
          },
          "alignment": "reviewed",
          "id": "ordinary-b0007",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℣. Gloria Patri. Alleluia.",
          "english": "℣. Glory be to the Father. Alleluia.",
          "sourcePages": [
            90
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              90
            ],
            "review": "editorial-review-complete"
          },
