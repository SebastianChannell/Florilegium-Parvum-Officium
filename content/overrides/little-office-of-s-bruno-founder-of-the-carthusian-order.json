        {
          "type": "prayer",
          "source": "Coloniae progenitus, Quam vocant Agrippinam, Ex inclyt is Parentibus, Sub juventutem primam Inferiora studia Bruno puellus adit, Quaeis omnibus industria Jam potior evadit, Sophiae post Parisius, Nec non Theologiae, Set totum sacris literis Impedit Bruno pie; Tanarquicidem studio, Ut palam respondere, Toroque in Palladio Doctrina emineret.",
          "english": null,
          "sourcePages": [
            472
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. A Parentibus genere et virtute claris Lutetiam Parisiorem missus, tantum ibi in Philosophiae et Theologiae studiis profecit, ut Doctoris et Magistri munus in utraque facultate sit adeptus.",
          "english": null,
          "sourcePages": [
            472
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ora pro nobis sancte Bruno,",
          "english": null,
          "sourcePages": [
            472
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut digni efficiamur promissionibus Christi.",
          "english": "℟. That we may be made worthy of the promises of Christ.",
          "sourcePages": [
            472
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              472
            ],
            "review": "editorial-review-complete",
            "method": "exact-source-memory",
            "memoryId": "6bc7298fc082f2a2"
          },
          "alignment": "reviewed",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus, Sancti Brunonis Confessoris tui, quaesumus, Domine, intercessionibus adjuvemur: ut qui majestatem tuam graviter delinquendo offendimus, ejus meritis et precibus nostrorum delictorum veniam consequamur. Per Dominum nostrum etc.",
          "english": null,
          "sourcePages": [
            472
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        }
