        {
          "type": "prayer",
          "source": "Haec territus tragedia Attonitus discedit, Dei pavens judicia Dum Noster domum redit, Charos cohortans socios Landuinum et Hugonem, Andream, duos Stephanos, Guarinum, se Brunonem Mox ut sequantur: Stygias Vitentque ut Harpyas, Per antra, per et latebras Scrutentur Coeli vias, Stricte servent silentia, Semperque meditentur Alta Dei judicia, Quois olim judicentur?",
          "english": null,
          "sourcePages": [
            473
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Tremens factus sum ego, et timeo; dum discussio venerit; atque ventura ira; libera me Domine de morte aeterna in die illa tremenda, quando coeli movendi sunt et terra.",
          "english": null,
          "sourcePages": [
            473
          ],
          "translation": null,
