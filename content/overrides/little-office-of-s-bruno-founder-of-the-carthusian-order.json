        {
          "type": "prayer",
          "source": "Theosophiae scrupulos Solvens abstrusiores, Doctrinae modestissimos Consociat et mores, Sacra et naturalia Arte tractans aequali, Suprema tandem laurea, Ornatur doctorali; Posthac, et post epomidem, Sacrum assumens statum, Pinguen capit propediem Rhemis Canonicatum; Statuì dies absitris Sed antequam illuxit, Horrendum drama coelitus Hunc saeculo subduxit.",
          "english": null,
          "sourcePages": [
            472
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Ab incunabulis specimen futurae sanctitatis praetulisse fertur, morum gravitate pueritiae aetatis; divina gratia favente, declinans in saeculi, ut jam monachorum Pater, et vitae anchoriticae futurus Instaurator agnoscere.",
          "english": null,
          "sourcePages": [
            472
          ],
          "translation": null,
          "alignment": "single-language",
