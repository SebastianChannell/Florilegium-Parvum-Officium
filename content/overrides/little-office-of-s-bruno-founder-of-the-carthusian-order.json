        {
          "type": "prayer",
          "source": "Doctorum Vir primarius Tum temporis obibat: Justus (ut vulgi publicus Tunc rumor circumibat) Sed huic cum officio Dum missa decantatur, Ter corpore exserto Se erigens, sic fatur: Justo Dei judicio Sum rite accusatus, Eodem sum et merito, Jusque judicatus, Aequa Dei sententia Sum condemnatus! quare Scitote, piis suffragiis, Nil sacra me juvare.",
          "english": null,
          "sourcePages": [
            473
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Accidit forte, ut Doctor quidam probatae alias (ut videbatur) vitae exercetur tumultuandus; cumque sub exsequiis sibi ferretur, justo Dei judicio se accusatum, judicatum et condemnatum publice et feretro proclamaret, Bruno cum sex Sociis se longinsimum fugiens in solitudinem.",
          "english": null,
          "sourcePages": [
            473
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0005",
          "verification": "pending"
