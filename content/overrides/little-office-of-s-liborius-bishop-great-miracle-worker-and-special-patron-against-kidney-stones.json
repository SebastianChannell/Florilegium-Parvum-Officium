    {
      "id": "conclusion",
      "title": "Conclusion",
      "sourceHeading": "Conclusio",
      "pages": [
        551
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Ista sunt, quae supplex oro, Ac pro quibus te imploro: O Patrone, audi me! Et tu Jesu, Dei nate, Nostri causa incarnate, Mea vota respice!",
          "english": null,
          "sourcePages": [
            551
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "conclusion-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Scio quidem, transgressorem Esse me, et peccatorem Coram tua facie: Sed tu, Jesu, rubicunda Me cruoris tui unda A peccatis ablue!",
          "english": null,
          "sourcePages": [
            551
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "conclusion-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Cum e caelo descendisti: Nomen Jesu assumpsisti, Ut in te stet nostra spes. Quaeso, nomen hoc attende, Salvatorem te ostende, Esto mihi, id quod es!",
          "english": null,
          "sourcePages": [
            551
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "conclusion-b0003",
          "verification": "pending"
        }
