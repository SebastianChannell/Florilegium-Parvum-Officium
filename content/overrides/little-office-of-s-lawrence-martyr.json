        {
          "type": "prayer",
          "source": "Post thesauros dum inquiris Vane tortor, nil acquiris Tibi; sed Laurentio",
          "english": null,
          "sourcePages": [
            553
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Hosce Christo coacervat, Quos hic in coronam servat Suo Dux armigero.",
          "english": null,
          "sourcePages": [
            553
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Et ut flamma cum calore Juncto unitat splendore, Sic et iste promicat,",
          "english": null,
