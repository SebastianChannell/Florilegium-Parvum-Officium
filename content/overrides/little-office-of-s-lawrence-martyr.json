        },
        {
          "type": "prayer",
          "source": "Laureato per agonem Laudis gestit mens sermonem Promere Laurentio.",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "O si puras ex amore Corde laudes dem et ore Martyum Delitio!",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Sixtus quidem jam ad mortem Rapitur: sed faustam sortem Patri ne invideas;",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Te supplicia plus dura, Et adversa manent plura, Martyr quae sustineas.",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Mundus gaudebit, vos autem contristabimini, sed tristitia vestra vertetur in gaudium.",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Per S. Laurentii preces et merita",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Libera nos Deus a flamma perpetua.",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": "Let us pray,",
          "sourcePages": [
            552
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              552
            ],
            "review": "editorial-review-complete",
            "method": "exact-source-memory",
            "memoryId": "e4264868331a5239"
          },
          "alignment": "reviewed",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Da nobis quaesumus Omnipotens Deus vitiorum nostrorum flammas extinguere, qui Beato Laurentio tribuisti tormentorum suorum incendia superare. Per Dominum nostrum Jesum Christum etc.",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
