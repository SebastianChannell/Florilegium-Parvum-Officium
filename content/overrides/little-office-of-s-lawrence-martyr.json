        {
          "type": "prayer",
          "source": "Jussus hinc dispensat aurum, Et Ecclesiae thesaurum Indigis Laurentius;",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Qua de re cum vocaretur Ad Tribunal, nil movetur Caesaris insultibus,",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Pyram licet hic minatur, Generosus rem effatur Flammas spernens rabidas,",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ecquid, rogat, his turbari, Vera magis num probari Auri potest puritas?",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Sicut igne probatur argentum et aurum camino, ita corda probat Dominus.",
          "english": null,
          "sourcePages": [
            552
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0008",
          "verification": "pending"
