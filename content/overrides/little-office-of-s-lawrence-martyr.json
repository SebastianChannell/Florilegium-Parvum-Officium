          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Sic in cheli tormentorum Christi resonat servorum Fidei confessio;",
          "english": null,
          "sourcePages": [
            552,
            553
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Inter ignium conflictus Stat Laurentius invictus Assa versans latera,",
          "english": null,
          "sourcePages": [
            553
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Spes interna consolatur, Dum superna vis hortatur Virum de constantia.",
          "english": null,
          "sourcePages": [
            553
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0007",
          "verification": "pending"
        },
