          "sourcePages": [
            553
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Neque corpus occidentes Timet, quia non valentes Mentem scit perimere;",
          "english": null,
          "sourcePages": [
            553
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ac ut vasa figulorum Fornax firmat, et illorum Solidat substantiam.",
