          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "O quam pulchra est casta generatio cum claritate! Immortalis enim est memoria illius, quoniam apud Deum nota est, et apud homines.",
          "english": null,
          "sourcePages": [
            432
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Specie tua et pulchritudine tua.",
          "english": null,
          "sourcePages": [
            432
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Intende, prospere procede, et regna.",
