          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ex stirpe nata Consulum, Amor, decusque siderum, Fausta Parentis unicum, Nostraque, salve, gaudium. Te Roma mundo protulit, Te Mater astris nutriit.",
          "english": null,
          "sourcePages": [
            432
          ],
          "translation": null,
