        },
        {
          "type": "prayer",
          "source": "Ave, dulcis Mater Christi Quae de Cruce mortuum Unis Natum suscepisti, Madens unda fletuum.",
          "english": null,
          "sourcePages": [
            397
          ],
          "translation": null,
