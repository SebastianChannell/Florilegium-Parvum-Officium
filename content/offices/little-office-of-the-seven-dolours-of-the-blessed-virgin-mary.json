        {
          "type": "prayer",
          "source": "Ave, dulcis Mater Christi, Quae sub Crucis arbore Gemens, Natum morti tristi Vides, heu! succumbere,",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "O per enses hujus doloris, Qui tunc scidit animam, Fac me firmet vis amoris Mortis ad victoriam.",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. O vos omnes, qui transitis per viam, attendite et videte, si est dolor, sicut dolor meus. (Thren. 1, 12.)",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Plauserunt super te manibus omnes transeuntes per viam.",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0009",
          "verification": "pending"
        },
