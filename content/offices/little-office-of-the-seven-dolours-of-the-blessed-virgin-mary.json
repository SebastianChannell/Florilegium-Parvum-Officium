      "sourceHeading": "Ad Matutinum",
      "pages": [
        395
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "I. Dolor ex Simeonis Vaticinio",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ave Maria, gratia plena, Dominus tecum. Benedicta tu in mulieribus, et benedictus fructus ventris tui Jesus. Sancta Maria, Mater Dei, ora pro nobis peccatoribus, nunc, et in hora mortis nostrae. Amen.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine, labia mea aperies.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus, in adjutorium meum intende.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine, ad adjuvandum me festina.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Gloria Patri. Alleluia.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "A Septuagesima usque ad Pascha, loco Alleluia, dicitur: Laus tibi, Domine, Rex aeternae gloriae.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ave, dulcis Mater Christi, Quae cur tuum gladio Transfingendum audis tristi Senis vaticinio.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Tanti memor fac doloris, Mihi sis praesidio, Ut post vallem hanc meroris Coeli reddar gaudio.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Cui comparabo te vel cui assimilabo te, filia Jerusalem? cui exaequabo te, et consolabor te, Virgo, filia Sion? magna est enim velut mare contritio tua. (Thren. 2, 13.)",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Tuam ipsius animam doloris gladius pertransibit.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut revelentur ex multis cordibus cogitationes. (Luc. 2, 35.)",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus, Interveniat pro nobis, quaesumus, Domine Jesu Christe, nunc et in hora mortis nostrae apud tuam clementiam B. Virgo Maria, Mater tua, cujus sacratissimam animam in hora tuae passionis doloris gladius pertransivit. Per te, Jesu Christe, Salvator mundi, qui cum Patre et Spiritu Sancto vivis et regnas in saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            395
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0015",
          "verification": "pending"
        }
      ]
    },
