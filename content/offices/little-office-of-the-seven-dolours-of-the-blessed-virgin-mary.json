        },
        {
          "type": "prayer",
          "source": "Ave, dulcis Mater Christi, Quae dolorem Filium Capi, caedi, flens vidisti Manibus crudeliùm:",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "O per poenas patientis, Nobis sit impunitas! Per amorem condolentis Matris crescat charitas!",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Videte, Domine, et considerate quoniam facta sum vilis: erectus est inimicus. Manum suam misit hostis ad omnia desiderabilia mea. (Thren. 1, 9–10.)",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Quia dedit capiti meo aquam, et oculis meis fontem lacrymarum.",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et plorabo die ac nocte.",
