        },
        {
          "type": "prayer",
          "source": "Ave, dulcis Mater Christi, Natum lugens inclytum: O quam tristis quaesivisti Triduo jam perditum!",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Hujus memor o doloris, Christum fac inveniam, Et inventum per amoris Nexum semper teneam.",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Plorans ploravit in nocte, et lacrimae ejus in maxillis ejus: non est qui consoletur eam ex omnibus charis ejus. (Thren. 1, 2.)",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Posuisti me desolatam.",
          "english": null,
          "sourcePages": [
            396
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Tota die merore confectam. (Thren. 1, 13.)",
