          "sourcePages": [
            587
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Tanto Cor ejus aestuabat amore, ut cum inter fines suos contineri non posset, confractis duabus costis, Dominus illud mirabiliter ampliaverit.",
