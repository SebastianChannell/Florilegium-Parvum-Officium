      "blocks": [
        {
          "type": "prayer",
          "source": "Jesus, Maria, Anna.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine, labia mea aperies.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus, in adjutorium meum intende.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adjuvandum me festina. Gloria Patri, et Filio, et Spiritui Sancto, Sicut erat in principio, et nunc, et semper, et in saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "O gloriosa Domina, De cujus Virgo genere Coeli Regem columen Laetavit sacro ubere.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Quod Eva tristis abstulit, Redditur Patri Filiae, Quae sancta sanctis procreat, Coeli fenestra facta est.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Tu Regis alti gratiam Deposce, atque veniam, Memoriam colentibus Tuae perennis gloriae.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Gloria tibi, Domine, Ex Anna natae germine, Cum Patre et Sancto Spiritu, In saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Antiphona",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Coeleste beneficium introivit in Annam, ex qua nobis nata est B. V. Maria.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ora pro nobis, sancta Anna.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut digni efficiamur promissionibus Christi.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0015",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deus, qui beatae Annae tantam gratiam conferre dignatus es, ut Genetricis unigeniti Filii tui mater effici mereretur: concede propitius, ut cujus memoriam veneramur in terris, ejus apud te patrociniis adjuvemur in coelis. Per eundem Dominum nostrum Jesum Christum, Filium tuum, qui tecum vivit et regnat in unitate Spiritus Sancti Deus, per omnia saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            436
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0016",
          "verification": "pending"
        }
      ]
    },
