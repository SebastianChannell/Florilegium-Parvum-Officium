          "id": "terce-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Hinc dum Caesar haec rescisit, Et quis Ductor sit, audivit, Ira tumens rabida, Huc Sebastianum dari Vinctum jubet, et raptari Ante tribunalai,",
          "english": null,
          "sourcePages": [
            591
          ],
