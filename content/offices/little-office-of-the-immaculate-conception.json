  "sections": [
    {
      "id": "ordinary",
      "title": "Ordinary",
      "sourceHeading": "Ordinaria",
      "pages": [
        383
      ],
      "blocks": [
        {
          "type": "rubric",
          "source": "Ad Matutinum",
          "english": "At Matins only",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Eia, mea labia, nunc annuntiate, laudes et praeconia Virginis beatae.",
          "english": "Come, my lips, and wide proclaim the Blessed Virgin’s spotless fame.",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0002",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Ad Completorium",
          "english": "At Compline only",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Convertat nos, Domina, tuis precibus placatur Iesus Christus Filius tuus.",
          "english": "℣. May Jesus Christ, thy Son, reconciled by thy prayers, O Lady, convert our hearts.",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et avertat iram suam a nobis.",
          "english": "℟. And turn away His anger from us.",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0005",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Ad Horas Omnes",
          "english": "At All the Hours",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domina, in adiutorium meum intende.",
          "english": "℣. O Lady, make speed to befriend me.",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Me de manu hostium potenter defende.",
          "english": "℟. From the hands of the enemy mightily defend me.",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Gloria Patri, et Filio, et Spiritui Sancto.",
          "english": "℣. Glory be to the Father, and to the Son, and to the Holy Spirit.",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Sicut erat in principio, et nunc, et semper, et in saecula saeculorum. Alleluia.",
          "english": "℟. As it was in the beginning, is now, and ever shall be, world without end. Alleluia.",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0010",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "A Septuagesima usque ad Pascha, loco Alleluia, dicitur: Laus tibi, Domine, Rex aeternae gloriae.",
          "english": "During Lent until Easter, instead of the alleluia the following is said: Praise to Thee, O Lord, King of everlasting glory.",
          "sourcePages": [
            383
          ],
          "englishPages": [
            383
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              383
            ]
          },
          "alignment": "candidate",
          "id": "ordinary-b0011",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "matins",
      "title": "Matins",
      "sourceHeading": "Ad Matutinum",
      "pages": [
        383,
        384
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Salve, mundi Domina, caelorum Regina: Salve, Virgo virginum, stella matutina",
          "english": null,
          "sourcePages": [
            383
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Salve, plena gratia, clara luce divina. Mundi in auxilium, Domina, festina.",
          "english": null,
          "sourcePages": [
            383
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ab aeterno Dominus te praeordinavit matrem unigeniti Verbi, quo creavit.",
          "english": null,
          "sourcePages": [
            383
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Terram, pontum, aethera, te pulchram ornavit sibi Sponsam, quae in Adam non peccavit.",
          "english": null,
          "sourcePages": [
            383
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Amen.",
          "english": null,
          "sourcePages": [
            384
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Elegit eam Deus, et praeelegit eam.",
          "english": null,
          "sourcePages": [
            384
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. In tabernaculo suo habitare fecit eam.",
          "english": null,
          "sourcePages": [
            384
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "matins-b0007",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "prime",
      "title": "Prime",
      "sourceHeading": "Ad Primam",
      "pages": [
        384
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Salve, Virgo sapiens, domus Deo dicata, columna septemplici mensaque exornata.",
          "english": "Hail, Virgin, most wise! Hail, Deity’s shrine! with seven fair pillars, and table divine!",
          "sourcePages": [
            384
          ],
          "englishPages": [
            384
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              384
            ]
          },
          "alignment": "candidate",
          "id": "prime-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ab omni contagio mundi praeservata. Semper sancta in utero matris, ex qua nata.",
          "english": "Preserved from the guilt which hath come upon us all! Exempt, in the womb, from the taint of the fall!",
          "sourcePages": [
            384
          ],
          "englishPages": [
            384
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              384
            ]
          },
          "alignment": "candidate",
          "id": "prime-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Tu Mater viventium, et porta es sanctorum. Nova stella Iacob, Domina angelorum.",
          "english": "O new Star of Jacob, of angels the Queen! O Gate of the saints! O Mother of men!",
          "sourcePages": [
            384
          ],
          "englishPages": [
            384
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              384
            ]
          },
          "alignment": "candidate",
          "id": "prime-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Zabulo terribilis acies castrorum. Porta et refugium sis Christianorum. Amen.",
          "english": "To Zabulon fearful as the embattled array! Be thou of the faithful the refuge and stay. Amen.",
          "sourcePages": [
            384
          ],
          "englishPages": [
            384
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              384
            ]
          },
          "alignment": "candidate",
          "id": "prime-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ipse creavit illam in Spiritu Sancto.",
          "english": "℣. The Lord Himself created her in the Holy Ghost.",
          "sourcePages": [
            384
          ],
          "englishPages": [
            384
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              384
            ]
          },
          "alignment": "candidate",
          "id": "prime-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et effundit illam super omnia opera sua.",
          "english": "℟. And poured her out over all His works.",
          "sourcePages": [
            384
          ],
          "englishPages": [
            384
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              384
            ]
          },
          "alignment": "candidate",
          "id": "prime-b0006",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "terce",
      "title": "Terce",
      "sourceHeading": "Ad Tertiam",
      "pages": [
        384,
        385
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Salve, arca foederis, thronus Salomonis, arcus pulcher aetheris, rubus visionis.",
          "english": "Hail, Solomon’s Throne! Pure Ark of the law fair Rainbow and Bush, which the patriarch saw!",
          "sourcePages": [
            384
          ],
          "englishPages": [
            384
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              384
            ]
          },
          "alignment": "candidate",
          "id": "terce-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Virga frondens germinis, vellus Gedeonis, porta clausa numinis, favusque Samsonis.",
          "english": "Hail, Gedeon’s Fleece! Hail, blossoming Rod! Samson’s sweet Honeycomb! Portal of God!",
          "sourcePages": [
            384
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "terce-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Decebat tam nobilem natum praecavere ab originali labe matris Evae.",
          "english": "Well-fitting it was that a Son so divine should preserve from all touch of original sin.",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "terce-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Almam, quam elegerat, Genetricem vere, nulli prorsus sinens culpae subiacere. Amen.",
          "english": "Nor suffer by smallest defect to be stained that Mother, whom He for Himself had ordained. Amen.",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "terce-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ego in altissimis habito.",
          "english": "℣. I dwell in the highest.",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "terce-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et thronus meus in columna nubis.",
          "english": "℟. And my throne is on the pillar of the clouds.",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "terce-b0006",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "sext",
      "title": "Sext",
      "sourceHeading": "Ad Sextam",
      "pages": [
        385
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Salve, Virgo puerpera, templum Trinitatis, angelorum gaudium, cella puritatis.",
          "english": "Hail, virginal Mother! Hail, purity’s Cell! Fair Shrine, where the Trinity loveth to dwell!",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "sext-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Solamen moerentium, hortus voluptatis, palma patientiae cedrus castitatis.",
          "english": "Hail, Garden of pleasure! Celestial Balm! Cedar of chastity! Martyrdom’s Palm!",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "sext-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Terra es benedicta et sacerdotalis, sancta et immunis culpae originalis.",
          "english": "Thou Land set apart from uses profane! And free from the curse which in Adam began!",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "sext-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Civitas altissimi, porta orientalis: in te est omnis gratia, Virgo singularis. Amen.",
          "english": "Thou City of God! Thou Gate of the east in thee is all grace o joy of the blest! Amen.",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "sext-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Sicut lilium inter spinas",
          "english": "℣. As the lily among the thorns.",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385
            ]
          },
          "alignment": "candidate",
          "id": "sext-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Sic amica mea inter filias Adae.",
          "english": "℟. So is my beloved among the daughters of Adam.",
          "sourcePages": [
            385
          ],
          "englishPages": [
            385,
            386
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              385,
              386
            ]
          },
          "alignment": "candidate",
          "id": "sext-b0006",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "none",
      "title": "None",
      "sourceHeading": "Ad Nonam",
      "pages": [
        385,
        386
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Salve, urbs refugii, turrisque munita David, propugnaculis armisque insignita.",
          "english": "Hail, City of refuge! Hail, David’s high tower, with battlements crowned and girded with power!",
          "sourcePages": [
            385,
            386
          ],
          "englishPages": [
            386
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              386
            ]
          },
          "alignment": "candidate",
          "id": "none-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "In conceptione caritate ignita draconis potestas est a te contrita.",
          "english": "Filled at thy conception with love and with light! The dragon by thee was shorn of his might.",
          "sourcePages": [
            386
          ],
          "englishPages": [
            386
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              386
            ]
          },
          "alignment": "candidate",
          "id": "none-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "O mulier fortis, et invicta Iudith! Pulchra Abisag virgo verum fovens David!",
          "english": "O Woman most valiant! O Judith thrice blest! As David was nursed in fair Abisag’s breast;",
          "sourcePages": [
            386
          ],
          "englishPages": [
            386
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              386
            ]
          },
          "alignment": "candidate",
          "id": "none-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Rachel curatorem Aegypti gestavit: Salvatorem mundi Maria portavit. Amen.",
          "english": "As the saviour of Egypt upon Rachel’s knee: so the world’s great Redeemer was cherished by thee. Amen.",
          "sourcePages": [
            386
          ],
          "englishPages": [
            386
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              386
            ]
          },
          "alignment": "candidate",
          "id": "none-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Tota pulchra es, amica mea.",
          "english": "℣. Thou art all fair, my beloved.",
          "sourcePages": [
            386
          ],
          "englishPages": [
            386
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              386
            ]
          },
          "alignment": "candidate",
          "id": "none-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et macula originalis numquam fuit in te.",
          "english": "℟. And the original stain was never in thee.",
          "sourcePages": [
            386
          ],
          "englishPages": [
            386
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              386
            ]
          },
          "alignment": "candidate",
          "id": "none-b0006",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "vespers",
      "title": "Vespers",
      "sourceHeading": "Ad Vesperas",
      "pages": [
        386,
        387
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Salve, horologium, quo, retrogradiatur sol in decem lineis; Verbum incarnatur.",
          "english": null,
          "sourcePages": [
            386
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "vespers-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Homo ut ab inferis ad summa attollatur, immensus ab angelis paulo minoratur.",
          "english": null,
          "sourcePages": [
            386
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "vespers-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Solis huius radiis Maria coruscat; consurgens aurora in conceptu micat.",
          "english": null,
          "sourcePages": [
            386
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "vespers-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Lilium inter spinas quae serpentis conterat caput: pulchra ut luna errantes collustrat.",
          "english": null,
          "sourcePages": [
            386
          ],
