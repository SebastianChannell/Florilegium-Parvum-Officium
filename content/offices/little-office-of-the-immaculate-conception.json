    {
      "id": "compline",
      "title": "Compline",
      "sourceHeading": "Ad Completorium",
      "pages": [
        387
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Salve, virgo florens, mater illibata, regina clementiae, stellis coronata.",
          "english": "Hail, Mother most pure! Hail, Virgin renowned! Hail, Queen with the starts, as a diadem, crowned.",
          "sourcePages": [
            387
          ],
          "englishPages": [
            387
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              387
            ]
          },
          "alignment": "candidate",
          "id": "compline-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Super omnes angelos pura, immaculata, atque ad regis dexteram stans veste deaurata.",
          "english": "Above all the angels in glory untold, standing next to the King in a vesture of gold.",
          "sourcePages": [
            387
          ],
          "englishPages": [
            387
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              387
            ]
          },
          "alignment": "candidate",
          "id": "compline-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Per te, mater gratiae, dulcis spes reorum, fulgens stella maris, portus naufragorum.",
          "english": "O Mother of mercy! O Star of the wave! O Hope of the guilty! O Light of the grave!",
          "sourcePages": [
            387
          ],
          "englishPages": [
            387
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              387
            ]
          },
          "alignment": "candidate",
          "id": "compline-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Patens caeli ianua salus infirmorum videamus regem in aula sanctorum. Amen.",
          "english": "Through thee may we come to the haven of rest; and see heaven’s King in the courts of the blest! Amen.",
          "sourcePages": [
            387
          ],
          "englishPages": [
            387
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              387
            ]
          },
          "alignment": "candidate",
          "id": "compline-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Oleum effusum, Maria, nomen tuum.",
          "english": "℣. Thy name, O Mary, is an oil poured out.",
          "sourcePages": [
            387
          ],
          "englishPages": [
            387
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              387
            ]
          },
          "alignment": "candidate",
          "id": "compline-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Servi tui dilexerunt te nimis.",
          "english": "℟. Thy servants have loved thee exceedingly.",
          "sourcePages": [
            387
          ],
          "englishPages": [
            387
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              387
            ]
