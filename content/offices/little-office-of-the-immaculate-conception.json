    {
      "id": "commendatio",
      "title": "Commendatio",
      "sourceHeading": "Ad Commendationem",
      "pages": [
        388,
        389
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Supplices offerimus tibi, virgo pia, haec laudum praeconia: Fac nos ut in via Ducas cursu prospero, et in agonia tu nobis assiste, O dulcis Maria.",
          "english": "These praises and prayers I lay at thy feet, O Virgin of virgins! O Mary most sweet! Be thou my true guide through this pilgrimage here: and stand by my side when death draweth near.",
          "sourcePages": [
            388
          ],
          "englishPages": [
            388
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              388
            ]
          },
          "alignment": "candidate",
          "id": "commendatio-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Deo gratias.",
          "english": "℟. Thanks be to God.",
          "sourcePages": [
            388
          ],
          "englishPages": [
            388
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              388
            ]
          },
          "alignment": "candidate",
          "id": "commendatio-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Haec est virga in qua nec nodus originalis, nec cortex actualis culpae fuit.",
          "english": "Ant. This is the rod in which was neither knot of original sin, nor rind of actual guilt.",
          "sourcePages": [
            388
          ],
          "englishPages": [
            388
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              388
            ]
          },
          "alignment": "candidate",
          "id": "commendatio-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. In conceptione tua virgo immaculata fuisti.",
          "english": "℣. In thy conception, O Virgin, thou wast immaculate.",
          "sourcePages": [
            388
          ],
          "englishPages": [
            388
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              388
            ]
          },
          "alignment": "candidate",
          "id": "commendatio-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ora pro nobis Patrem, cuius Filium peperisti.",
          "english": "℟. Pray for us to the Father, Whose Son thou didst bring forth.",
          "sourcePages": [
            388
          ],
          "englishPages": [
            388,
            389
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              388,
              389
            ]
          },
          "alignment": "candidate",
          "id": "commendatio-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus, Deus, qui per immaculatam Virginis conceptionem dignum Filio tuo habitaculum praeparasti: quaesumus, ut qui ex morte eiusdem Filii tui praevisa eam ab omni labe praeservasti, nos quoque mundos eius intercessione ad te pervenire concedas. Per eundem Christum Dominum nostrum. Amen.",
          "english": "Let us pray, O God, Who by the immaculate conception of the Virgin, didst prepare a worthy habitation for Thy Son, we beseech Thee that, as in view of the death of that Son, Thou didst preserve her from all stain of sin, so Thou wouldst enable us, being made pure by her intercession, to come unto Thee. Through the same Christ our Lord. Amen.",
          "sourcePages": [
            388,
            389
          ],
          "englishPages": [
            389
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              389
            ]
          },
          "alignment": "candidate",
          "id": "commendatio-b0006",
          "verification": "pending"
        }
      ]
    }
