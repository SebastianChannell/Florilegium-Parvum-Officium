          "sourcePages": [
            512
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "gratulatio-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            512
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "gratulatio-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Domine Jesu Christe, pro cujus amore et fidei confessione beatus Georgius Martyr et Miles tuus invictissimus diversa vicit tormenta, et ad mortem usque certando capitalem subiit sententiam; praesta, quaesumus, ut qui ad eum in angustiis nostris fiducialiter recurrere praesumimus, intercessionis ejus auxilio a diaboli laqueis, et ab omni mentis et corporis adversitate liberemur. Qui vivis et regnas etc. Amen.",
          "english": null,
          "sourcePages": [
            512
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "gratulatio-b0007",
          "verification": "pending"
