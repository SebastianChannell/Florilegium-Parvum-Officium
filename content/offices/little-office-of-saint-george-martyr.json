          "english": null,
          "sourcePages": [
            510
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Justum deduxit Dominus per vias rectas,",
          "english": null,
          "sourcePages": [
            510
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0008",
          "verification": "pending"
        },
