          "sourcePages": [
            510
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Nam qui divina noscit, Terrena non exposcit: Nunc nervis quoque vapulat Quos Miles Christi tolerat",
          "english": null,
          "sourcePages": [
            510
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Nervosus inter scuticaes Sartagines et ungulas; Quin saxum et molare Jam suscipit portare.",
          "english": null,
          "sourcePages": [
            510
          ],
          "translation": null,
          "alignment": "single-language",
