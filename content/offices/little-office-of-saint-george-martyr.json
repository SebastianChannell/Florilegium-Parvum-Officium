          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Partis trophaeis plurimis, Centumque fusis hostibus, Florebat amplis gratiis Et Caesarum favoribus,",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Tam stemmate excellens, Quam meritis praecellens: At Christiani nominis Haud immemor nec pectoris,",
          "english": null,
          "sourcePages": [
            508,
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Christum colebat integre, Multatum quamvis sanguine Id praesciabat fore, Fidem probat cruore;",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Laus sit perpetua Patrique, Filioque, Spiranti ab utroque Par sit et gloria.",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Posuisti Domine super caput ejus",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Coronam de lapide pretioso.",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Presta quaesumus Omnipotens Deus, ut qui beati Georgii Martyris tui glorioso martyrio colimus, intercessione ejus in tui Nominis amore roboremur. Per Dominum nostrum etc.",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0011",
          "verification": "pending"
        }
      ]
    },
