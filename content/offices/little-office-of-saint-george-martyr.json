        },
        {
          "type": "prayer",
          "source": "His efferatus vocibus, Spumantis instar pelagi, Caesar jubet, Georgius Arcto mandetur carcere,",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Sed hem! Tyranne audi, Non potest virtus claudi: Est carcer ut palatium, Aulae sacrae compendium,",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Nescit ligari funibus, Catenae sunt prae torquibus, Amantis in thesauro Plus vincula valent auro.",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Laus sit perpetua, Patrique, Filioque, Spiranti ab utroque Par sit et gloria.",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Justus ut palma florebit.",
          "english": null,
          "sourcePages": [
            510
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Sicut cedrus Libani multiplicabitur.",
          "english": null,
          "sourcePages": [
            510
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            510
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Infirmitatem nostram respice Omnipotens Deus; et quia pondus propriae actionis gravat, beati Georgii Martyris tui intercessio gloriosa nos protegat. Per Dominum nostrum etc.",
          "english": null,
          "sourcePages": [
            510
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0011",
          "verification": "pending"
