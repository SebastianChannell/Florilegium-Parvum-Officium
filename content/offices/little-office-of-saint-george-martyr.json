          "id": "prime-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Spontaneae solertia Occasio non desuit. Dum Caesaris saevitiae Pavore procul restitit,",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Idola contemnendo, Sic Caesari loquendo: Christiadum cur sanguinem Quid purpuram tam nobilem",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Immisit ita appetis? Crudelis ita prodigis? Si sanguis est fundendus, Ab improbis petendus.",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Laus sit perpetua, Patrique, Filioque, Spiranti ab utroque Par sit et gloria.",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Magna est gloria ejus in salutari tuo,",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Gloriam et magnum decorem impones super eum.",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Largire, quaesumus Omnipotens Deus, ut intercedente beato Georgio Martyre tuo, et a cunctis adversitatibus liberemur in corpore, et a pravis cogitationibus mundemur in mente. Per Dominum etc.",
          "english": null,
          "sourcePages": [
            509
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0011",
          "verification": "pending"
        }
      ]
