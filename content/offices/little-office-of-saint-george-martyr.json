      "id": "invocation",
      "title": "Invocation",
      "sourceHeading": "Invocatio",
      "pages": [
        508
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Heros Georgi maxime! Christi Ducis Commilito, Veram profuso sanguine Fidem probans martyrio;",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "invocation-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Te nostrae nunc amandae Depraedicent camaenae: Qui inter aulae Regulos, Et Satrapas Caesareos,",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "invocation-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Excelsa belli Nomina, Cessi Phoebus inter sidera Prae cunctis elucebas, Virtutibus clarebas,",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "invocation-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Fac nos perpetua, Cum Patre, Genitoque, Paraclito Sanctoque, Gaudere gloria. Amen.",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "invocation-b0004",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "matins",
      "title": "Matins",
      "sourceHeading": "Matins",
      "pages": [
        508
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "℣. Domine labia mea aperies.",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus in adjutorium meum intende.",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adjuvandum me festina. Gloria Patri etc.",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Martem secutus inclytum Christi pugil Georgius Ut Caesaris signiferi Exhibuit se strenuus",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Aetate Juvenili: Secuta mox virili Pro milite nunc martyr sit, Ne dubium proinde sit,",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Sic Deo se, quae Dei sunt, Et Caesari, quae sua sunt, Dedisse: ut impleret, Quae Christus nos doceret;",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Laus sit perpetua Patrique, Filioque, Spiranti ab utroque Par sit et gloria.",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Gloria et honore coronasti eum Domine,",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et constituisti eum super opera manuum tuarum.",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deus qui nos beati Georgii Martyris tui meritis et intercessione laetificas, concede propitius, ut qui tua per eum beneficia poscimus, dono tuae gratiae consequamur. Per Dominum nostrum Jesum Christum etc.",
          "english": null,
          "sourcePages": [
            508
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        }
      ]
    },
