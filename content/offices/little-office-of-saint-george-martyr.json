    {
      "id": "gratulatio",
      "title": "Gratulatio",
      "sourceHeading": "Gratulatio",
      "pages": [
        511,
        512
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Tibi Martyr victoriam Applaudo contra Caesarem, Qui firmam per constantiam Hostem vicisti desidem;",
          "english": null,
          "sourcePages": [
            511
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "gratulatio-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Fac tecum nos certare, Hostesque superare: Fac mundum, carnem sternere, Terrena quavis spernere, Fac in adversis solidos, Pro Jesu quidquid strenuos (Quam nobis id amare Contingat) supportare.",
          "english": null,
          "sourcePages": [
            511,
            512
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "gratulatio-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Divina gratia Patrique, Filioque, Paraclito Sanctoque Haec praestet munera.",
          "english": null,
          "sourcePages": [
            512
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "gratulatio-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Accipite armaturam Dei,",
