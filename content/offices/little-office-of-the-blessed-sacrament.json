  "sections": [
    {
      "id": "ordinary",
      "title": "Ordinary",
      "sourceHeading": "Ordinaria",
      "pages": [
        54
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "℣. Panem Angelorum manducavit homo, et paratur ei mensa Domini.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0001",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Ad Matutinum",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine labia mea aperies.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0004",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Ad Completorium",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Converte nos, Deus salutaris noster.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et averte iram tuam a nobis.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0007",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Ad Horas Omnes",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus in adiutorium meum intende.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adiuvandum me festina.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Gloria Patri, et Filio, et Spiritui Sancto.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Sicut erat in principio, et nunc, et semper, et in saecula saeculorum. Alleluia.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0012",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "A Septuagesima usque ad Pascha, loco Alleluia, dicitur: Laus tibi, Domine, Rex aeternae gloriae.",
          "english": null,
          "sourcePages": [
            54
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "ordinary-b0013",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "matins",
      "title": "Matins",
      "sourceHeading": "Ad Matutinum",
      "pages": [
        54
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Pange, lingua, gloriosi Corporis mysterium, Sanguinisque pretiosi, quem in mundi pretium fructus ventris generosi Rex effudit Gentium.",
          "english": "Sing, my tongue, the Saviour’s glory, of His flesh the mystery sing; of the Blood, all price exceeding, shed by our immortal King, destined, for the world’s redemption, from a noble womb to spring.",
          "sourcePages": [
            54
          ],
          "englishPages": [
            54
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54
            ]
          },
          "alignment": "candidate",
          "id": "matins-b0001",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "prime",
      "title": "Prime",
      "sourceHeading": "Ad Primam",
      "pages": [
        54,
        55
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Nobis datus, nobis natus ex intacta Virgine, et in mundo conversatus, sparso verbi semine, sui moras incolatus miro clausit ordine.",
          "english": "Of a pure and spotless Virgin born for us on earth below, He, as Man, with man conversing, stayed, the seeds of truth to sow; then He closed in solemn order wondrously His life of woe.",
          "sourcePages": [
            54,
            55
          ],
          "englishPages": [
            54,
            55
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              54,
              55
            ]
          },
          "alignment": "candidate",
          "id": "prime-b0001",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "terce",
      "title": "Terce",
      "sourceHeading": "Ad Tertiam",
      "pages": [
        55
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "In suprema nocte cenae recumbens cum fratribus observata lege plene cibis in legalibus, cibum turbae duodenae se dat suis manibus.",
          "english": "On the night of that Last Supper, seated with His chosen band, He the Pascal victim eating, first fulfills the Law’s command; then as Food to His Apostles gives Himself with His own hand.",
          "sourcePages": [
            55
          ],
          "englishPages": [
            55
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              55
            ]
          },
          "alignment": "candidate",
          "id": "terce-b0001",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "sext",
      "title": "Sext",
      "sourceHeading": "Ad Sextam",
      "pages": [
        55
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Verbum caro, panem verum verbo carnem efficit: fitque sanguis Christi merum, et si sensus deficit, ad firmandum cor sincerum sola fides sufficit.",
          "english": "Word made Flesh, the bread of nature by His word to Flesh He turns; wine into His Blood He changes; what though sense no change discerns? Only be the heart in earnest, faith her lesson quickly learns.",
          "sourcePages": [
            55
          ],
          "englishPages": [
            55
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              55
            ]
          },
          "alignment": "candidate",
          "id": "sext-b0001",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "none",
      "title": "None",
      "sourceHeading": "Ad Nonam",
      "pages": [
        55
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Panis angelicus fit panis hominum; dat panis caelicus figuris terminum; O res mirabilis: manducat Dominum pauper, servus et humilis.",
          "english": "Thus Angels’ Bread is made the Bread of man today: the Living Bread from heaven with figures dost away: O wondrous gift indeed! the poor and lowly may upon their Lord and Master feed.",
          "sourcePages": [
            55
          ],
          "englishPages": [
            55
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              55
            ]
          },
          "alignment": "candidate",
          "id": "none-b0001",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "vespers",
      "title": "Vespers",
      "sourceHeading": "Ad Vesperas",
      "pages": [
        55
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Tantum ergo Sacramentum veneremur cernui: et antiquum documentum novo cedat ritui: praestet fides supplementum sensuum defectui.",
          "english": "Down in adoration falling, Lo! the sacred Host we hail; Lo! o’er ancient forms departing, newer rites of grace prevail; faith for all defects supplying, where the feeble sense fail.",
          "sourcePages": [
            55
          ],
          "englishPages": [
            55
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              55
            ]
          },
          "alignment": "candidate",
          "id": "vespers-b0001",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "compline",
      "title": "Compline",
      "sourceHeading": "Ad Completorium",
      "pages": [
        55
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Genitori, Genitoque laus et iubilatio, salus, honor, virtus quoque sit et benedictio: procedenti ab utroque compar sit laudatio.",
          "english": "To the everlasting Father, and the Son who reigns on high, with the Holy Ghost proceeding forth from Each eternally, be salvation, honour, blessing, might and endless majesty.",
          "sourcePages": [
            55
          ],
          "englishPages": [
            55
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              55
            ]
          },
          "alignment": "candidate",
          "id": "compline-b0001",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "conclusion",
      "title": "Conclusion",
      "sourceHeading": "Conclusio",
      "pages": [
        55,
        56
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "O quam suavis est Domine spiritus tuus, qui ut dulcedinem tuam in filios demonstrares, pane suavissimo de caelo praestito esurientes reples bonis, fastidiosos divites dimittens inanes.",
          "english": null,
          "sourcePages": [
            55,
            56
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "conclusion-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Panem de caelo praestitisti eis.",
          "english": null,
          "sourcePages": [
            56
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "conclusion-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Omne delectamentum in se habentem.",
          "english": null,
          "sourcePages": [
            56
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "conclusion-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            56
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "conclusion-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deus, qui nobis sub Sacramento mirabili Passionis tuae memoriam reliquisti; tribue, quaesumus, ita nos Corporis et Sanguinis tui sacra mysteria venerari, ut redemptionis tuae fructum in nobis iugiter sentiamus: Qui vivis et regnas in saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            56
          ],
          "translation": null,
          "alignment": "unpaired",
          "id": "conclusion-b0005",
          "verification": "pending"
        }
      ]
    }
  ],
  "unpairedEnglish": [
    {
      "section": "ordinary",
      "blocks": [
        {
          "type": "prayer",
          "text": "℣. Man hath eaten the bread of Angels, and the table of our Lord is prepared for him.",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "At Matins only",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "℣. O Lord, open my lips.",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "℟. And my mouth will announce Thy praise.",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "At Compline only",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "℣. Convert us, O God our Saviour.",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "℟. And turn away Thy wrath from us.",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "At all the Hours",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "℣. O God, come to my aid.",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "℟. O Lord, make haste to help me.",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "℣. Glory be to the Father, and to the Son, and to the Holy Spirit.",
          "pages": [
            54
          ]
        },
        {
          "type": "prayer",
          "text": "℟. As it was in the beginning, is now, and ever shall be, world without end. Alleluia.",
          "pages": [
            54
          ]
        },
        {
          "type": "rubric",
          "text": "During Lent until Easter, instead of the alleluia the following is said: Praise to Thee, O Lord, King of everlasting glory.",
          "pages": [
            54
          ]
        }
      ]
    },
    {
      "section": "conclusion-of-the-hours",
      "title": "Conclusion of the Hours",
      "blocks": [
        {
          "type": "prayer",
          "text": "O how sweet, O Lord, is Thy Spirit, who, that Thou mightest show Thy sweetness towards Thy children, by most sweet bread sent from Heaven fillest the hungry with good things, send the rich away empty.",
          "pages": [
            56
          ]
        },
        {
          "type": "prayer",
          "text": "℣. Thou hast given us bread from Heaven.",
          "pages": [
            56
          ]
        },
        {
          "type": "prayer",
          "text": "℟. Filled with all sweetness and delight.",
          "pages": [
            56
          ]
        },
        {
          "type": "prayer",
          "text": "Let us pray,",
          "pages": [
            56
          ]
        },
        {
          "type": "prayer",
          "text": "O God, who under a wonderful Sacrament hast left us a memorial of Thy Passion; grant us, we beseech Thee, so to reverence the sacred mysteries of Thy Body and Blood, that we may ever feel within ourselves the fruit of Thy Redemption: Thou who livest and reignest forever and ever. Amen.",
          "pages": [
            56
          ]
        }
      ]
    }
  ]
}
