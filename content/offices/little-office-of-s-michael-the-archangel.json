      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Sancte Michael Archangele, defende me in praelio, ut non peream in tremendo judicio. Amen.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine labia mea aperies.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus in adjutorium meum intende.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adjuvandum me festina. Gloria Patri et Filio etc. Alleluia.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Vel a Septuagesima usque ad Pascha: Laus tibi Domine Rex aeternae gloriae.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Invicte princeps Michael, exercitus caelestis; quae magna facta gesseris, laudum canamus hymnis.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Antiphona",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Michael praeposite paradisi, quem honorificant Angelorum cives, intercede pro nobis ad Dominum.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Gloriosus apparuisti in conspectu Domini.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Propterea decorem induit te Dominus.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deus cujus claritatis fulgore, beatus Michael praecellit agmina Angelorum; praesta quaesumus, ut sicut ille dono tuo principatum meruit habere coelestem, ita et nos ejus precibus vitam obtineamus aeternam. Per Christum Dominum nostrum. Amen.",
          "english": null,
          "sourcePages": [
            416
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
        }
      ]
    },
