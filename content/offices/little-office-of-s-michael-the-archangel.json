          "alignment": "single-language",
          "id": "terce-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ducente te grex Israel olim per annos multos defensus est, et attigit promissionis terram.",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0005",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Antiphona Exodi 23",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Mittam Angelum meum, qui praecedat te et custodiat in via, et introducat in locum quem praeparavi.",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Apprehende arma et scutum sancte Michael.",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et exurge in adjutorium mihi.",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "O Invicte Dux, et Princeps militiae Domini, sancte Michael, veni quaeso in auxilium animae meae, quae continenter in tanto periculo a suis inimicis carne, mundo, daemone impugnatur; et sicut dux fuisti populo Israel per desertum, sic quoque velis esse dux et comes meus per desertum hujus mundi, donec secure me perduxeris ad felicem terram viventium. Amen.",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0011",
          "verification": "pending"
        }
      ]
    },
