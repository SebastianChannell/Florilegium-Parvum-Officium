          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Tu, sicut olim jussus es praeesse Synagogae; nunc factus es Ecclesiae Protector universae.",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0005",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Antiphona",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Princeps gloriosissime Michael, Dux coelestium exercituum, susceptor animarum debellator malorum spirituum, Ecclesiae Dei post Christum admirabilis et grandis excellentiae et virtutis, rector, omnes nos reclamantes ad te ab omni libera adversitate, et in omni cultu Dei facias proficere, tuo preciosissimo officio et dignissima prece.",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ora pro nobis S Michael.",
          "english": null,
          "sourcePages": [
            417
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut digni efficiamur promissionibus Christi.",
          "english": null,
          "sourcePages": [
            418
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            418
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Omnipotens sempiterne Deus qui saluti humanae naturae ex summa clementia tua, gloriosum Principem Ecclesiae tuae Michaelem Archangelum mirabiliter deputasti: concede propitius, ut ejus salutari subsidio hic mereamur ab omnibus hostibus tueri efficacissime, et in obitu nostro ab omni tentatione liberari, tuaeque excelsae majestati beatifice per eum praesentari. Per Christum Dominum nostrum. Amen.",
          "english": null,
          "sourcePages": [
            418
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0011",
          "verification": "pending"
        }
      ]
    },
