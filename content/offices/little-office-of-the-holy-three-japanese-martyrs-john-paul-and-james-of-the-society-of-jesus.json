          },
          "alignment": "reviewed",
          "id": "prime-b0004",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Per vestra solvi vincula Nexus rogamus criminum, Mens ut beatis libera Caeli fruatur sedibus.",
          "english": "Through your chains we ask that the bonds of our sins be loosed, so that the mind, set free, may enjoy the blessed dwellings of heaven.",
          "sourcePages": [
            545
          ],
          "translation": {
            "kind": "prepared",
