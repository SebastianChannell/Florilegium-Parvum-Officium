        {
          "type": "prayer",
          "source": "O lata animos viscera; O caritatis pectora! Quae non tyranni vincula Stringere valent, aut verbera.",
          "english": "O hearts wide with courage! O breasts filled with charity, which neither a tyrant’s chains nor his scourges can constrain!",
          "sourcePages": [
            545
          ],
          "translation": {
            "kind": "prepared",
            "preparedFor": "Sacrum Florilegium",
            "sourcePages": [
              545
            ],
