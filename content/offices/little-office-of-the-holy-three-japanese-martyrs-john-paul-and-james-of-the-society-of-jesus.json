          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut digni efficiamur promissionibus Christi.",
          "english": null,
          "sourcePages": [
            547
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus, Omnipotens aeterne Deus, qui servis tuis Paulo, Joanni, et Jacobo in Societatem Filii tui vocatis, Apostolicum studium in Gentium conversionem et Haereticorum reductionem inspirasti; ideoque Martyrii gloria decorasti: concede propitius, ut ipsis, et Passionis Sociis in hoc mundo et consolationis deinde in aeterna beatitudine esse mereamur. Per Dominum nostrum Jesum Christum, qui tecum vivit et regnat in unitate Spiritus Sancti Deus, per omnia saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            547
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0005",
