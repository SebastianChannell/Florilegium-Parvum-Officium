          "sourcePages": [
            547
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Orate pro nobis, beati Martyres.",
