    {
      "id": "commendatio",
      "title": "Commendatio",
      "sourceHeading": "Commendation",
      "pages": [
        559,
        560
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Sume Jesu quae devota Mente tibi solvi vota. In Ludgero adoravi, In Ludgero praedicavi Te Supremam Triadem.",
          "english": null,
          "sourcePages": [
            559
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Fac in morte ut purgatus, Et amore inflammatus, Caelo phoenix moriturus, In supernis oriturus, Moriar in gratia.",
          "english": null,
          "sourcePages": [
            559
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "His in votis Jesum spero, Extra Jesum nihil quaero: Gloriosus cum Ludgero Tanto surgam junctus Hero In die judicii.",
          "english": null,
          "sourcePages": [
            559
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ergo lux Episcoporum, Spes, asylum miserorum, Tuta salus orphanorum, Ac clientum devotorum Decus et praesidium.",
          "english": null,
          "sourcePages": [
            559,
            560
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "In suprema mortis hora Precor adsis sine mora. Fac, quod olim promisisti, Dux sis mihi, ut dixisti, Ad locum judicii.",
          "english": null,
          "sourcePages": [
            560
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Jesum si pro me orabis, Scio, Judicem placabis: Hoc confidens in te spero, Extra Jesum nihil quaero Vivus atque mortuus.",
          "english": null,
          "sourcePages": [
            560
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0006",
          "verification": "pending"
        }
      ]
