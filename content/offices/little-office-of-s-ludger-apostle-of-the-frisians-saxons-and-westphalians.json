          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Huc adeste Seraphini Igneique Cherubini, Corda sursum sublevate, Tepidumque excitate, Corde totus ardeam.",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deum meum adorabo, Et in Sanctis praedicabo: Ah quam vellem! aestuaret, Et amore cor flagraret; Dum Ludgerum praedico.",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Liasburga dum gerebat, Et Ludgerum continebat Sinu, cadens fauciata, Atque dire vulnerata, Servat hunc incolumem.",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Mille Jesu perennanti, Mille grates sint Tonanti, Flaminique tot honores, Sempiternum quot amores Fovet alma Trinitas.",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Antiphona (Isai. 49)",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Audite insulae, et attendite populi de longe:",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Dominus ab utero vocavit me; De ventre matris meae recordatus est nominis mei.",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ora pro nobis beate Ludgere.",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut digni efficiamur promissionibus Christi.",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0015",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0016",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deus, qui conspicis, quia nos undique mala nostra perturbant, praesta, quaesumus, ut beati Ludgeri Confessoris tui atque Pontificis intercessio gloriosa nos protegat. Per Dominum nostrum Jesum Christum Filium tuum, qui tecum vivit et regnat in unitate Spiritus Sancti Deus, per omnia saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            555
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0017",
          "verification": "pending"
        }
      ]
