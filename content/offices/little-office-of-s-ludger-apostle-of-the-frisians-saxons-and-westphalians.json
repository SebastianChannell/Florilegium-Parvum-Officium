          "sourcePages": [
            557
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ad Nortmannos subjugandos, Christo Jesu sociandos, Te accingens, morbo pressus Persequentum graves laesus Nuntias Ecclesiae.",
          "english": null,
