          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "A Septuagesima usque ad Pascha, loco Alleluia, dicitur: Laus tibi, Domine, Rex aeternae gloriae.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Fatalis o agonis Patrona Barbara, Coelestibus coronis, Gemmisque fulgida! Moerentis in novissimo Mors certa spiculo Sed, Virgo, te favente, Sum par periculo.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Osee. 2. 19. Sponsabo te mihi in sempiternum; et sponsabo te mihi in justitia et judicio, et in misericordia, et in miserationibus.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ora pro nobis, sancta Virgo et Martyr Barbara.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut felix nobis sit mortis hora.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Intercessio, quaesumus, Domine, sanctae virginis et martyris tuae Barbarae nos adjuvet: ut qui ejus patrocinio in angustiis et necessitatibus nostris imploramus, auxilium quoque in hora potissimum mortis experiarmur. Per Dominum nostrum.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine, exaudi orationem meam.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0015",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et clamor meus ad te veniat.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0016",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Benedicamus Domino.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0017",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Deo gratias.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0018",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Fidelium animae per misericordiam Dei requiescant in pace.",
          "english": null,
          "sourcePages": [
            450
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0019",
