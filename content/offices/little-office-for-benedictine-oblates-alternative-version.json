          ]
        },
        {
          "type": "prayer",
          "text": "O praise the Lord, all ye nations: praise Him, all ye people. For His mercy is confirmed upon us: and the truth of the Lord remaineth for ever. Glory be to the Father, etc. As it was in the beginning, etc.",
          "pages": [
            633
          ]
        },
        {
          "type": "prayer",
          "text": "℣. Let us bless the Lord.",
          "pages": [
            633
          ]
        },
