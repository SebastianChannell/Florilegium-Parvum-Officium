    {
      "id": "commendatio",
      "title": "Commendatio",
      "sourceHeading": "Commendatio",
      "pages": [
        66,
        67
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Has Horas canonicas cum devotione. Tibi, Christe, recolo pia ratione:",
          "english": null,
          "sourcePages": [
            66
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ut qui pro me passus es amoris ardore, Sis mihi solatium mortis in agone. Amen.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0002",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Vexilla Regis prodeunt: Fulget Crucis mysterium, Qua vita mortem pertulit, Et morte vitam protulit.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Quae vulnerata lanceae Mucrone diro, criminum Ut nos lavaret sordibus, Manavit unda, et sanguine.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Impleta sunt quae concinit David fideli carmine; Dicendo nationibus: Regnavit a ligno Deus.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Arbor decora, et fulgida, Ornata Regis purpura, Electa digno stipite Tam sancta membra tangere.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Beata, cujus brachiis Pretium pependit saeculi, Statera facta corporis Tulitque praedam tartari.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "O Crux ave spes unica, Hoc passionis tempore, Piis adauge gratiam, Reisque dele crimina.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Te, fons salutis, Trinitas: Collaudet omnis spiritus: Quibus Crucis victoriam Largiris, adde praemium.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Amen.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0011",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Temp. Pasch. dic. Paschale quae fers gaudium. Per annum dic. In hac triumphii gloria.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "commendatio-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus, Respice, quaesumus Domine, super hanc familiam tuam, pro qua Dominus noster Jesus Christus non dubitavit manibus tradi nocentium, et crucis subire tormentum. Qui tecum vivit, et regnat in saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            67
          ],
          "translation": null,
          "alignment": "single-language",
