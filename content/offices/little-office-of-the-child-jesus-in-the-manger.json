          "translation": null,
          "alignment": "single-language",
          "id": "conclusion-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Hodie in domo tua oportet me manere: Hodie huic domui salus facta est.",
