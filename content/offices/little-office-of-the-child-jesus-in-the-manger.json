          "id": "none-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ecquid inter hos dolores, Quos mi Jesu digne plores! Tamen blandule renides, Dum me peccatorem vides, Tibi, inter Pastores Genibus adrepere! Nempè mei quod ardore Primae mox ab ortu horae Haec sustines, atque plura Adhuc ferre petas dura, Atque tuo sic amore Meum tibi quaerere.",
          "english": null,
          "sourcePages": [
            50
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Ludens erat in Orbe terrarum, et deliciae ejus esse cum filiis hominum.",
          "english": null,
          "sourcePages": [
            50
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Dilexit Patres suos.",
          "english": null,
          "sourcePages": [
            50
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et elegit semen eorum post eos.",
          "english": null,
          "sourcePages": [
            50
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            50
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Odulcis Jesule! mirande amator hominum! da, ut dum sine causa meriti ab aeterno me praedilexisti; Ego quoque nec spe praemii nec metu poenae, sed solum redamem te Deus propter te. Qui cum Patre etc.",
          "english": null,
          "sourcePages": [
            50
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0010",
          "verification": "pending"
        }
      ]
    },
