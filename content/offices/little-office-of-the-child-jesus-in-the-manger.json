      "pages": [
        51
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Non Paternus vero Thronis, At nec lecto Salomonis, Sponsae thalamo electae Neque compar est, Dilecte Jesu! membra quo reponis, Meus iste lectulus: Sed qui palam publicorum Tecta quondam peccatorum Visitare jam decernis, Scio: nec Cor meum spernis; Tuis pie quod in thorum Detuli amoribus,",
          "english": null,
          "sourcePages": [
