          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Adjuro vos filiae Jerusalem, per capreas, cervosque camporum, ne suscitetis, neque evigilare faciatis dilectum meum, donec ipse velit.",
