        {
          "type": "prayer",
          "source": "Sed nec musto vel liquore, Nec hoc digni sumus rore, Si discordes moribus. In obscuris vel divis, Sancta nequit Paraclysis Habitare cordibus.",
          "english": null,
          "sourcePages": [
