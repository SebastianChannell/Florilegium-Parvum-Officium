          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Tu commutas elementa, Per te sua sacramenta Praestant efficaciam. Tu malignam vim repellis, Tu subvertis et refellis Hostium nequitiam.",
          "english": null,
          "sourcePages": [
            100,
            101
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Te docente nil obscurum, Te praesente nil impurum, Cuncta sunt splendida; Gloriatur mens jucunda, Per te sana, per te munda, Gaudet conscientia.",
          "english": null,
          "sourcePages": [
            101
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ure igne, etc. cum Oratione.",
          "english": null,
          "sourcePages": [
            101
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0007",
          "verification": "pending"
        }
      ]
