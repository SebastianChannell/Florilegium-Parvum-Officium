        },
        {
          "type": "prayer",
          "source": "Tu perversos corde vitas, Sed sinceros mente ditas Dono sapientiae, Veritatem notam facis, Et ostendis viam pacis, Semitas justitiae.",
          "english": null,
          "sourcePages": [
            101
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Dat liquorem Helisaeus, Largum fundit rorem Deus, Ubi vasa vacua, Utres novi non vetusti Sunt capaces novi musti, Sint et nostra pectora.",
          "english": null,
          "sourcePages": [
            101
          ],
          "translation": null,
