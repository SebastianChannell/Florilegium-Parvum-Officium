          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Consolator ergo veni, Linguas rege, corda leni, Pelle fel et toxica, Nil salubre, nil serenum, Nihil dulce, nihil plenum, Sine tua gratia.",
