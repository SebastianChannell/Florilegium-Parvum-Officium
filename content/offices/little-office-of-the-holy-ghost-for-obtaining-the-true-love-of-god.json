        },
        {
          "type": "prayer",
          "source": "O quam felix, quam festiva Dies, in qua primitiva Conditur Ecclesia, Sunt primitias jam vivae, Neonatae Matris Divae Tria plebis millia;",
          "english": null,
          "sourcePages": [
            101
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Panes Legis primitivi, Una fiant adoptivi Fide duo populi; Nempes duos unum fecit, Cum duobus se praefecit Lapis caput anguli.",
          "english": null,
          "sourcePages": [
            101
          ],
          "translation": null,
          "alignment": "single-language",
