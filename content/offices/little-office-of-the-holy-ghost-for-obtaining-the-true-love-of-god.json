        },
        {
          "type": "prayer",
          "source": "O ter salubre unguentum! Aquae ditans elementum Sacro in baptismate! Te laudamus mente pura, Prius irae, ex natura, Gratiae nunc filii!",
          "english": null,
          "sourcePages": [
            102
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "vespers-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Tu quid dator es et donum, Ex quo omne fluit bonum, Cor perfunde gaudio, Tange mentem, purga sordes, Vinclo pacis fac concordes, Jugi sis praesidio.",
          "english": null,
          "sourcePages": [
            102
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "vespers-b0006",
