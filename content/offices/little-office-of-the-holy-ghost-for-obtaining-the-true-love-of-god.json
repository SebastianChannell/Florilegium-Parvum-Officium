      "id": "preparation",
      "title": "Preparation",
      "sourceHeading": "Praeparatio",
      "pages": [
        100
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Qui procedis ab utroque, Genitore, Genitoque, Spiritus Paraclyte! Redde linguas eloquentes, Sed accende primum mentes Charitatis fomine.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "preparation-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Fac, o dulcis coeli aura, Corque nostrum sic instaura, Pietatis flammulis, Ut quae fundimus haec vota, Ex amore fluant tota, Sacri plena pneumatis.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "preparation-b0002",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "matins",
      "title": "Matins",
      "sourceHeading": "Matins",
      "pages": [
        100
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "℣. Veni Sancte Spiritus, reple tuorum corda fidelium, et tui amoris ignem in eis accende.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Amen.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine labia mea aperies.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus in adjutorium meum intende.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adjuvandum me festina. Gloria Patri, etc.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Tu procedens a duobus, Coaequalis es ambobus, Nulla est disparitas; Par Majestas Personarum, Par Potestas singularum, Et communis Deitas.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Amor Patris, Filiique, Par amborum, et utrique Gloria consimilis, Coelos imples, terras foves, Mare domas, cuncta moves, Permanens immobilis.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ure igne, Sancte Spiritus, renes nostros, et cor nostrum Domine.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut tibi casto corpore serviamus, et mundo corde placeamus.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Oratio",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deus, cui omne cor patet, et omnis voluntas loquitur, et quem nullum latet secretum: purifica per infusionem Sancti Spiritus cogitationes cordis nostri, ut te perfecte diligere et digne laudare mereamur. Per Dominum nostrum Jesum Christum.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine exaudi orationem meam.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et clamor meus ad te veniat.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0015",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Benedicamus Domino.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0016",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Deo gratias.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0017",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Et Fidelium animae per misericordiam Dei requiescant in pace.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0018",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Amen.",
          "english": null,
          "sourcePages": [
            100
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0019",
          "verification": "pending"
        }
      ]
    },
