      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "℣. Domine labia mea aperies. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus Pater in adjutorium meum intende.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Te Deum Patrem laudamus,",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Te Conditorem coeli, et terrae confitemur.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adjuvandum me festina. Gloria Deo Patri: Sicut erat in principio, et nunc, et semper, et in saecula saeculorum. Amen. Alleluja.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Lucis Creator optime, Lucem dierum proferens, Primordiis lucis novae, Mundi paras originem. Qui mane junctum vesperi, Diem vocari praecipis, Fac, cedat omne noxium, Purgetur omne pessimum.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Benedicamus Deum Patrem.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Laudemus, et superexaltemus eum in saecula.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Benedictio, et claritas, et sapientia, et gratiarum actio, honor, virtus, et fortitudo, Deo Patri in saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine exaudi orationem meam.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et clamor meus ad te veniat.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Da nobis, quaesumus Omnipotens et aeterne Deus, auxilium gratiosae tuae pietatis: ut Te Patrem ingenitum, Deum verum, Creatorem coeli et terrae, visibilium omnium et invisibilium, esse credimus; in exequendis quoque mandatis tuis voluntate, et actione, semper tibi placeamus: qui Deus es in saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            23
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
        }
      ]
    },
