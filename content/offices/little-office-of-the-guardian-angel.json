          "alignment": "reviewed",
          "id": "conclusion-of-the-hours-b0003",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": "Let us pray,",
          "sourcePages": [
            414
          ],
          "englishPages": [
            414
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              414
            ]
          },
          "alignment": "reviewed",
          "id": "conclusion-of-the-hours-b0004",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Deus, qui ineffabili providentia sanctos Angelos tuos ad nostram custodiam mittere digneris, largire supplicibus tuis, et eorum semper protectione defendi, et aeterna sociate gaudere. Per Dominum nostrum Iesum Christum.",
          "english": "O God, who in Thine ineffable providence hast deigned to send Thy holy Angels to watch over us, grant to us, Thy supplicants, to be always defended by their protection and in eternity to share their joy. Through our Lord Jesus Christ.",
          "sourcePages": [
            414
          ],
          "englishPages": [
            414,
            415
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              414,
              415
            ]
          },
          "alignment": "reviewed",
          "id": "conclusion-of-the-hours-b0005",
          "verification": "visual-review"
        }
