      "title": "Commendatio",
      "sourceHeading": "Commendatio",
      "pages": [
        414,
        415
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Has horas canonicas cum devotione Dixi, custos Angele tui ratione: Precor, me custodias mortis in agone, Et praesens me deducas in caeli regione.",
          "english": "These hours Canonical with devotion to thy rule, O Guardian Angel, I didst say: I bid thee guard me at death’s hour, and carry me to heaven to live alway.",
          "sourcePages": [
            414,
            415
          ],
          "englishPages": [
            415
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              415
            ]
          },
          "alignment": "reviewed",
          "id": "commendatio-b0001",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Angele Dei, qui custos es mei, Me tibi commissum pietate superna; Hac nocte illumina, custodi, rege, et guberna. Amen.",
          "english": "Angel of God, my guardian dear, to whom his love commits me here; ever this night be at my side, to light and guard, to rule and guide. Amen.",
          "sourcePages": [
            415
          ],
          "englishPages": [
            415
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              415
            ]
          },
          "alignment": "reviewed",
