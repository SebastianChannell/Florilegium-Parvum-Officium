          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℣. In conspectu Angelorum psallam tibi, Deus meus.",
          "english": "℣. In the sight of Angels I will sing to Thee, O God.",
          "sourcePages": [
            414
          ],
          "englishPages": [
            414
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              414
            ]
          },
          "alignment": "reviewed",
          "id": "conclusion-of-the-hours-b0002",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℟. Adorabo ad templum sanctum tuum et confitebor nomini tuo.",
          "english": "℟. I will worship facing Thy holy temple and confess Thy name.",
          "sourcePages": [
            414
          ],
          "englishPages": [
            414
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              414
            ]
