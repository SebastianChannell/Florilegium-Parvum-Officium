      "title": "Conclusion of the Hours",
      "sourceHeading": "Conclusio Horae",
      "pages": [
        414
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Sancti Angeli, custodes nostri, defendite nos in proelio, ut non pereamus in tremendo iudicio.",
          "english": "O ye holy Angels, our guardians, defend us in battle that we may not perish in the awful judgment.",
          "sourcePages": [
            414
          ],
          "englishPages": [
            414
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              414
            ]
