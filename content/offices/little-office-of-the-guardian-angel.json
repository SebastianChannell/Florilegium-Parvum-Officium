    {
      "id": "matins",
      "title": "Matins",
      "sourceHeading": "Ad Matutinum",
      "pages": [
        413
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Custodes hominum psallimus Angelos, naturae fragili quos Pater addidit caelestis comites, insidiantibus ne succumberet hostibus.",
          "english": "The Guardians of our race, our Angel Guides we hail; our Father sendeth forth to aid our nature frail these heavenly friends, lest we should suffer overthrow through cunning of our subtle foe.",
          "sourcePages": [
            413
          ],
          "englishPages": [
            413
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              413
            ]
          },
          "alignment": "reviewed",
