          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. With joy shall ye draw water",
          "english": null,
          "sourcePages": [
            63
          ],
          "translation": {
            "kind": "source-English",
            "sourcePages": [
              63
            ]
          },
          "alignment": "single-language",
          "id": "compline-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. From the fountains of the Saviour. The waters sent from Heaven flow from the opening of his heart.",
          "english": null,
          "sourcePages": [
            63
          ],
          "translation": {
            "kind": "source-English",
            "sourcePages": [
              63
            ]
          },
          "alignment": "single-language",
