          "sourcePages": [
            82
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "prime-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Qui factus est vobis in salutem.",
