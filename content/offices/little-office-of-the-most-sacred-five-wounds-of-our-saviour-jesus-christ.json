          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Avete sacra Vulnera, In carne Christi fulgida, Nostrae salutis inclita Jam restitutae pignora.",
          "english": null,
          "sourcePages": [
            81
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Manus ave te sauciae, Pedesque tincti sanguine, Diro pendentes stipite, Transfixi clavi cuspide.",
          "english": null,
          "sourcePages": [
            81
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Aveto Latus roseum, Tam late patens ostium Amanti Domicilium, Erranti Diversorium.",
