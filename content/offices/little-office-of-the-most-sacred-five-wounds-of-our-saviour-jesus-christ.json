        {
          "type": "rubric",
          "source": "A Septuagesima usque ad Pascha loco Alleluja dicitur: Laus tibi Domine Rex aeternae Gloriae.",
          "english": null,
          "sourcePages": [
            81
          ],
          "translation": null,
