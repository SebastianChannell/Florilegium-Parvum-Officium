          "id": "terce-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Antiphona Visitavit Dominus terram, et sanguine suo inebriavit eam, multiplicavit locupletavit eam.",
          "english": null,
          "sourcePages": [
            82
          ],
          "translation": null,
