          "sourcePages": [
            83
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Sub umbra alarum tuarum protege me, Domine.",
