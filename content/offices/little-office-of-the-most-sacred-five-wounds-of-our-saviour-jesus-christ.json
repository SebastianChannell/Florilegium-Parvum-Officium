            81
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Laus tibi sit, et Gloria, Rex Christe pro victoria, Per sacra parta Vulnera, Magnae salutis Pretia.",
