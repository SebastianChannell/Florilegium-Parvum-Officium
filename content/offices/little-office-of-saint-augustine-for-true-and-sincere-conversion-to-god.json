      "sourceHeading": "Invocatio",
      "pages": [
        446
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Salve Pater Sanctissime Sedes scientiarum, Sectariorum malleus, Lucerna scripturarum; Episcoporum Gloria, Doctorque veritatis, Tu supplicantes adjuva, Exemplar pietatis, Laudare ut pro viribus Quem pie hic conamur, Patrono in coelestibus Te semper perfruamur!",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "invocation-b0001",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "matins",
      "title": "Matins",
      "sourceHeading": "Matins",
      "pages": [
        446
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Amor Jesu accendat praecordia nostra. Amen.",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine labia mea aperies.",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus in adjutorium meum intende.",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adjuvandum me festina. Gloria Patri etc.",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Aurora veris tenera Primo aetatis flore, Ut et juventus valida, Ebulliens calore,",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Non sat pudica fluxerat Addicta vanitati, Saclicque tunc scateurat Errore depravati; Nam Manichaea haeresi Mens erat illinita, Ut gemma, quae sub sordidi Est luto coeni sita.",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Invenit Augustinus se longe esse a Deo in Regione dissimilitudinis, et respexit eum Dominus, et misit in mentem ejus, et lucebat in eo gratia Dei: et invisibilia Dei per ea, quae facta sunt, intellectu conspexit, et non tardavit converti ad Dominum.",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Elegit eum Dominus sacerdotem sibi,",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ad sacrificandum ei hostiam laudis.",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Adesto supplicationibus nostris Omnipotens Deus, et quibus fiduciam sperandae pietatis indulges, intercedente beato Augustino confessae misericordiae tribue benignus effectum. Per Dominum nostrum etc.",
          "english": null,
          "sourcePages": [
            446
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        }
      ]
    },
