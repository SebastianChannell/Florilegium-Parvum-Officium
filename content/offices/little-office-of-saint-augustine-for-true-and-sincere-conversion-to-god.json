          "id": "compline-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Praesul sanctissime Augustine, Canon vitae Canonicae, via morum, Doctor egregie, Lux Doctorum, roga Christum pro nobis, ut nostris adsit mentibus, et in aeterna requie suis jungat agminibus.",
          "english": null,
