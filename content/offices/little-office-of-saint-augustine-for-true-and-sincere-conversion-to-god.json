          "alignment": "single-language",
          "id": "terce-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Aquis perfusus lustricis Mentem sortitur mundam, Patrinis gaudet Superis, Candore vincens undam,",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Et purus jam a sordibus Coelique Candidatus, Peccata tingit fletibus, Et abluit reatus;",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Sic saepe poenitentia Plus habet sanctitatis, Quam signis innocentia In pace puritatis.",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Conversus est ad Deum ex toto corde suo, in jejunio, in fletu et planctu. Et misertus est ejus ex alto Dominus, quoniam multus est ad ignoscendum.",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Justum deduxit Dominus per vias rectas,",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et ostendit illi Regnum Dei.",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Exaudi quaesumus Domine preces nostras, quas in Beati Augustini conversione deferimus, et qui tibi digne meruit famulari, ejus suffragantibus meritis, ab omnibus nos absolve peccatis. Per Dominum nostrum etc.",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "terce-b0012",
          "verification": "pending"
        }
      ]
