        },
        {
          "type": "prayer",
          "source": "Praesul mirato vertice Supremae Sanctitatis, Devinxit sectas strenue, Hostesque veritatis,",
          "english": null,
          "sourcePages": [
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Pelagiana somnia Convellit et revellit, Falsa perstringit dogmata, Et haereses repellit,",
          "english": null,
          "sourcePages": [
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Doctoris jure laurea Et mista sic ornatus, Ecclesiae fert munia Quaternus Doctoratus.",
          "english": null,
          "sourcePages": [
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. In medio Ecclesiae aperuit os ejus, et implevit eum Dominus Spiritu sapientiae et intellectus, jucunditatem et exultationem thesaurizavit super eum.",
          "english": null,
          "sourcePages": [
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Lex Dei in corde ipsius.",
          "english": null,
          "sourcePages": [
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et non supplantabuntur gressus ejus.",
          "english": null,
          "sourcePages": [
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deus, qui per B. Augustinum Confessorem tuum atque Pontificem Ecclesiam tuam nova prole fecundasti, praesta quaesumus, ut ejus intercessione, quod ore simul et opere docuit, te adjuvante exercere valeamus. Per Dominum etc.",
          "english": null,
          "sourcePages": [
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "none-b0012",
          "verification": "pending"
        }
      ]
