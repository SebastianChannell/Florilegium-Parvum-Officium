        },
        {
          "type": "prayer",
          "source": "Aetate tandem plurima, Sed non labore lassus, Febri crematur ignea, Plus ab amore passus,",
          "english": null,
          "sourcePages": [
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "vespers-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Sed nempe Phoeninx gratiae, Phoenix scientiarum, Dierum finem clauderet Sic decus istuarum;",
