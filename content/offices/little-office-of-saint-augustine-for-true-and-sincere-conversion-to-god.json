          "alignment": "single-language",
          "id": "compline-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Per Orbis spargit ambitum, Trans aequor et promulgat, Ultraque solem cognitum Per socios divulgat.",
