          "id": "sext-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Divini totus conflagrant Ut ignibus amoris, Supemis sic exuberat Et imbribus favoris,",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Quid eligat? hinc Vulnera Cruore purpurata? Num casta Matris Ubera Lacte inebriata?",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Quid praestat? eligere Ambiguo vix datur, Dum hic laetatur ubere, Hic sanguine potatur.",
          "english": null,
          "sourcePages": [
            447
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Qui vicerit, faciet illum Dominus columnam in templo suo, et scribet super eum nomen suum, et nomen Civitatis novae Jerusalem. Erit fidelis usque ad mortem, et dabit illi coronam vitae, quam promisit diligentibus se.",
          "english": null,
          "sourcePages": [
            447,
            448
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "sext-b0008",
          "verification": "pending"
        }
      ]
    },
