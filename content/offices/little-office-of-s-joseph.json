    {
      "id": "terce",
      "title": "Terce",
      "sourceHeading": "Ad Tertiam",
      "pages": [
        421
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Dum in Bethlehem profecturus, pergeres cum Virgine, Deus nobis par futurus, natus est in tempore.",
          "english": "With the Virgin, young and tender in the winter-time forlorn, thou to Bethlehem didst journey that our Lord might there be born.",
          "sourcePages": [
            421
          ],
          "englishPages": [
            421
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              421
            ]
          },
          "alignment": "reviewed",
          "id": "terce-b0001",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Quem in faeno collocatum, coluisti graviter: nunc in caelo elevatum: ora pro me iugiter.",
          "english": "As thy God thou didst adore Him,\nwhile He in the manger lay,\nnow is He in heaven exalted-\nturn to Him for us and pray!",
          "sourcePages": [
            421
          ],
          "englishPages": [
            421
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              421
            ]
