    {
      "id": "vespers",
      "title": "Vespers",
      "sourceHeading": "Ad Vesperas",
      "pages": [
        422
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Quam dolebas, cum quaerebas, doudennem Iesulum! Sed inventus et retentus, auxit illi gaudium.",
          "english": "Thou didst search with loving anguish For the little Jesus lost, But, in finding Him, what rapture Purchased at that sorrow’s cost!",
          "sourcePages": [
            422
          ],
          "englishPages": [
            422
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              422
            ]
          },
          "alignment": "reviewed",
          "id": "vespers-b0001",
          "verification": "visual-review",
          "editorialNote": "The printed Latin reads “doudennem”; the supplied poetic English is retained without silently rewriting the Latin."
