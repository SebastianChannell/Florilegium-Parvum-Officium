    {
      "id": "prime",
      "title": "Prime",
      "sourceHeading": "Ad Primam",
      "pages": [
        421
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Cum ferentem castam Matrem, conspexisses uterum, et nescires tamen Patrem, cor gerebas anxium;",
          "english": "Sorely was thy bosom troubled till the mystery was revealed which the Lord had wrought in Mary, who in patience all concealed.",
          "sourcePages": [
            421
          ],
          "englishPages": [
            421
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              421
            ]
          },
          "alignment": "reviewed",
          "id": "prime-b0001",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Sed de caelo mox instructus, posuisti dubium. Fac ut omnis meus luctus Transeat in Gaudium.",
          "english": "But an angel soon from heaven bids thy loving doubts to cease. So may every care and trial turn for me to joy and peace.",
          "sourcePages": [
            421
          ],
          "englishPages": [
            421
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              421
            ]
          },
          "alignment": "reviewed",
          "id": "prime-b0002",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Ant. (Mt 1:20) Ioseph fili David, noli timere accipere Mariam coniugem tuam, quod enim in ea natum est, de Spiritu Sancto est.",
          "english": "Ant. (Mt 1:20) Joseph, son of David, fear not to take unto thee Mary as thy spouse, for what is conceived in her is of the Holy Spirit.",
          "sourcePages": [
            421
          ],
          "englishPages": [
            421
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              421
            ]
