      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Magne Ioseph, Fili David, custos date Virginis, quem et Virgo nuncupavit patrem Christi Domini;",
          "english": "Mighty Joseph, son of David!\nHigh and glorious is thy state-\nof our Lord the Foster-father,\nMary’s spouse Immaculate.",
          "sourcePages": [
            420
          ],
          "englishPages": [
            420
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              420
            ]
          },
          "alignment": "reviewed",
          "id": "matins-b0001",
          "verification": "visual-review",
          "originalExtractedEnglish": "Mighty Joseph, son of David! High and glorious is thy stateof our Lord the Foster-father, Mary’s spouse Immaculate.",
          "editorialNote": "Visual review restores the printed line break after the punctuation hyphen; the original joined extraction is retained."
        },
        {
          "type": "prayer",
          "source": "Qui fidelis Servus Dei datus es familiae, precor velis curam mei tamquam Pater gerere.",
          "english": "The Almighty’s faithful servant, of the Holy Family, head and father. Oh! I pray thee be a father unto me.",
          "sourcePages": [
            420
          ],
          "englishPages": [
            420,
            421
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              420,
              421
            ]
          },
          "alignment": "reviewed",
          "id": "matins-b0002",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Ant. (Psalmus 104) Constituit eum Dominum Domus suae, et Principem omnis possessionis suae.",
          "english": "Ant. (Psalm 104) He made him master of his house, and ruler over all his possessions.",
          "sourcePages": [
            421
          ],
          "englishPages": [
            421
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              421
            ]
          },
          "alignment": "reviewed",
          "id": "matins-b0003",
          "verification": "visual-review"
        }
