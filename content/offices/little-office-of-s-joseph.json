    {
      "id": "sext",
      "title": "Sext",
      "sourceHeading": "Ad Sextam",
      "pages": [
        421,
        422
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Vim Herodis evasisti, monitus ab Angelo, in Aegyptum cum duxisti Virginem cum parvulo.",
          "english": "Fleeing at the angel’s warning, far from Herod’s fury wild, long in Egypt didst thou tarry with the Virgin and the Child.",
          "sourcePages": [
            421
          ],
          "englishPages": [
            421
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              421
            ]
          },
          "alignment": "reviewed",
          "id": "sext-b0001",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Per moerorem, quem tulisti, isto in exilio, cum gravabor hora tristis mihi sis auxilio.",
          "english": "By thy toil, and pain, and sadness, In that exile dark and drear, Help me in the cares and sorrows Which may be my portion here.",
          "sourcePages": [
            421,
            422
          ],
          "englishPages": [
            421,
            422
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              421,
              422
            ]
          },
          "alignment": "reviewed",
          "id": "sext-b0002",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "Ant. (Mt 2:13) Surge, et accipe Puerum et Matrem eius, et fuge in Aegyptum, et esto ibi usque dum dicam tibi; futurum est enim, ut Herodes quaerat Puerum ad perdendum Eum.",
          "english": "Ant. (Mt 2:13) Rise and take the Child and his Mother, and fly into Egypt, and be there until I tell thee; for it will come to pass that Herod will seek the Child to destroy Him.",
          "sourcePages": [
            422
          ],
          "englishPages": [
            422
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              422
            ]
          },
          "alignment": "reviewed",
          "id": "sext-b0003",
          "verification": "visual-review"
        }
