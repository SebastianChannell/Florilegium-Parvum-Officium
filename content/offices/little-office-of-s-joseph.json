        },
        {
          "type": "prayer",
          "source": "℟. Sicut erat in principio, et nunc, et semper, et in saecula saeculorum. Alleluia.",
          "english": "℟. As it was in the beginning, is now, and ever shall be, world without end. Alleluia.",
          "sourcePages": [
            420
          ],
          "englishPages": [
            420
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              420
