            420
          ],
          "englishPages": [
            420
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
              420
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0003",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": "℟. And my mouth will announce Thy praise.",
          "sourcePages": [
            420
          ],
          "englishPages": [
            420
          ],
          "translation": {
            "kind": "supplied",
            "sourcePages": [
