            "kind": "supplied",
            "sourcePages": [
              420
            ]
          },
          "alignment": "reviewed",
          "id": "ordinary-b0009",
          "verification": "visual-review"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adiuvandum me festina.",
          "english": "℟. O Lord, make haste to help me.",
          "sourcePages": [
            420
          ],
          "englishPages": [
            420
          ],
          "translation": {
