      "title": "Matins",
      "sourceHeading": "Matins",
      "pages": [
        498
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Narrabo nomen tuum fratribus meis: in medio Ecclesiae laudabo te.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine, labia mea aperies.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus, in adjutorium meum intende.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adjuvandum me festina. Gloria Patri, et Filio, et Spiritui Sancto. Sicut erat in principio, et nunc, et semper, et in saecula saeculorum. Amen.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Illustre sidus Principum, Francisce salve maxime; Qui foetido cadavere Viso, horruisti saeculum.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Averte nostra lumina, Ne vanitates hauriant, Sed in supernam caelitum Sint fixa saeculum jugiter.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Antiphona",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Taeduit me vitae meae, videns me mala universae sub sole, et cohorruit aeternitas vanitatem et afflictionem spiritus.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Non aspiciam hominem ultra, et habitatorum quietis.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Haec requies mea in saeculum saeculi: quoniam elegi eam.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Omnipotens, sempiterne Deus, qui spreta vanitate, beatum Franciscum Borgiam et Societatem Filii tui vocare dignatus es: praesta, quaesumus, ut, quem eximia sanctimoniae exempla par habuimus in terris, ejus coronae participes fieri mereamur in caelis. Per Christum Dominum nostrum. Amen.",
          "english": null,
          "sourcePages": [
            498
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
        }
      ]
    },
