        },
        {
          "type": "prayer",
          "source": "℟. Because by your Holy Cross you have redeemed the world.",
          "english": null,
          "sourcePages": [
            656
          ],
          "translation": {
            "kind": "source-English",
            "sourcePages": [
              656
            ]
          },
