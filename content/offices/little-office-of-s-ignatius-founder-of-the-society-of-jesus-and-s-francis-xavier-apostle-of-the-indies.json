      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "O patroni, vos amore, Vos honore prosequor: Corde laudo vos et ore, Voce, mente comprecor. Vos faventis verba vultu Comprecatem cernite, Proque vestro vota cultu Ne clientem spernite.",
          "english": null,
          "sourcePages": [
            522
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "oblatio-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Vestra nobis impetrate Nosse nos vestigia, Vestra (Numen invocate) Nos videre lumina. O nitenti quando sole Illa lux se proferet, Corporisque quando mole Illa sors nos eximet! Amen.",
          "english": null,
          "sourcePages": [
            522
