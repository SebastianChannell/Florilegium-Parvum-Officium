    {
      "id": "conclusion",
      "title": "Conclusion",
      "sourceHeading": "Conclusio",
      "pages": [
        585
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Nostra tibi Dive Paule Sume haec obsequia! Qui coelestis inter aulae Jam triumphas gaudia, Fac nos serio conversos Christum sequi jugiter, Faustis, nec adversis merlos Plaudere perenniter.",
          "english": null,
          "sourcePages": [
            585
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "conclusion-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Non oculus vidit, nec auris audivit, nec in cor hominis ascendit, quae praeparaverit Deus iis, qui diligunt illum.",
          "english": null,
          "sourcePages": [
            585
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "conclusion-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "OV. Ora pro nobis S. Paule Apostole. NR. Ut digni efficiamur promissionibus Christi.",
          "english": null,
          "sourcePages": [
            585
          ],
          "translation": null,
