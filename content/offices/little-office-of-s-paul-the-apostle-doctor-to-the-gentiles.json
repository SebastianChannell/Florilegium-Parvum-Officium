          "alignment": "single-language",
          "id": "compline-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Jamque Paulus per lictotes Mancipatur vinculis: Flagellato per tortores Sed mandato Caesaris Postquam caput detruncatur, Lac cruorque profluit, Fonsque salva dum levatur Tertus terno profluit.",
          "english": null,
          "sourcePages": [
            585
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "compline-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Aestimati sumus sicut oves occisionis, sed in his omnibus superamus, propter hunc, qui dilexit nos.",
          "english": null,
          "sourcePages": [
            585
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "compline-b0005",
          "verification": "pending"
