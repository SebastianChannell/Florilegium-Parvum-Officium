        {
          "type": "prayer",
          "source": "Sed Damascum ut tendenti Christus occlamaverat; Saule dic, me persequendi Quae te causa agitat? Equo lapsus mox respondes: Dic, quid me vis facere! Jugo Christi te despondes, Sacro lotus flumine.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Abiit Ananias, et imponens ei manus, dixit: Misit me Jesus, ut videas; et surgens baptizatus est.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "lauds-b0006",
