      "title": "Praefatio",
      "sourceHeading": "Praefatio.",
      "pages": [
        583
      ],
      "blocks": [
        {
          "type": "prayer",
          "source": "Paule vas electionis, Magne Doctor gentium, Ardens fax dilectionis, Vera lux credentium! Accipe, quod pio corde Munuus hic deferimus, Tuis licet quaque sorte Meritis inferius.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "praefatio-b0001",
          "verification": "pending"
        }
      ]
    },
    {
      "id": "matins",
      "title": "Matins",
      "sourceHeading": "Ad Matutinum.",
      "pages": [
        583
      ],
      "blocks": [
        {
          "type": "rubric",
          "source": "Vas electionis est mihi iste, ut portet Nomen meum coram Gentibus, et Regibus, et Filiis Israel.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0001",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Domine labia mea aperies,",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0002",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Et os meum annuntiabit laudem tuam.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0003",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Deus in adjutorium meum intende.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0004",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Domine ad adjuvandum me festina. Gloria Patri etc.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0005",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Hymnus",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0006",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Saulus adhuc dum vocaris, Paulus donec fueras, Unice delectabaris Perdere Christicolas; Adolescens impiorum Curam geris vestium, Lapidat dum Judaeorum Gens proterva Stephanum.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Ant. Supra modum persequebar Ecclesiam Dei, et proficiebam in Judaismo, super multos coartancos meos.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ora pro nobis S. Paule Apostole.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut digni efficiamur promissionibus Christi.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deus, qui multitudinem Gentium Beati Pauli Apostoli praedicatione docuisti: Da nobis, quaesumus, ut cujus merita colimus, ejus apud te patrocinia sentiamus. Per Dominum nostrum etc. Amen.",
          "english": null,
          "sourcePages": [
            583
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        }
      ]
    },
