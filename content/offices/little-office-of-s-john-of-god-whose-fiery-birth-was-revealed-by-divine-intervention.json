          "sourcePages": [
            541
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0011",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Fidelis servus, et prudens quem constituit Dominus super familiam suam pro cura infirmorum, pauperum, et afflictorum.",
          "english": null,
          "sourcePages": [
            541
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0012",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℣. Ora pro nobis, sancte Joannes Dei.",
          "english": null,
          "sourcePages": [
            541
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0013",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "℟. Ut digni efficiamur promissionibus Christi.",
          "english": null,
          "sourcePages": [
            541
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0014",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Oremus,",
          "english": null,
          "sourcePages": [
            541
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0015",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Deus, qui per caritatem beati Joannis Dei infirmis, pauperibus, et afflictis clementer subvenisti: concede propitius, ut ejus meritis et precibus ab omni semper infirmitate, periculo, et adversitate misericorditer protegamur et liberemur. Per Dominum nostrum Jesum Christum, etc.",
          "english": null,
          "sourcePages": [
            541
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0016",
          "verification": "pending"
        }
      ]
