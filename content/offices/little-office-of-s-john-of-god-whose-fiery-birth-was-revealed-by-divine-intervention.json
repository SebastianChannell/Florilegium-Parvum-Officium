          "id": "matins-b0007",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Laus Joanni sit, qui Patrum Posuit primordia, Sacri Ordinis, et Fratrum de misericordia,",
          "english": null,
          "sourcePages": [
            541
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0008",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Cujus ortu glorioso Gaudet Lusitania Fato sit hic ominoso Miles in Hispania,",
          "english": null,
          "sourcePages": [
            541
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0009",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Apparente sed mutavit Divae Deiparae, Et ad pia applicavit Charitatis opera.",
          "english": null,
          "sourcePages": [
            541
          ],
          "translation": null,
          "alignment": "single-language",
          "id": "matins-b0010",
          "verification": "pending"
        },
        {
          "type": "rubric",
          "source": "Antiphona",
