          ],
          "translation": null,
          "alignment": "single-language",
          "id": "vespers-b0005",
          "verification": "pending"
        },
        {
          "type": "prayer",
          "source": "Antiph. O sacrum convivium, in quo Christus sumitur, recolitur memoria passionis ejus, mens impletur gratia, et futura gloriae nobis pignus datur.",
          "english": null,
          "sourcePages": [
            59
